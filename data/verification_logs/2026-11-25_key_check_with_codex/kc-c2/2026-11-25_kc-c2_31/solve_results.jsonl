{"item_id": "BM0739", "position": 739, "batch": "2026-11-25_kc-c2_31", "anon_id": "M-31-020", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "x <- factor(c(\"A\", \"A\", \"A\"), levels = c(\"A\", \"B\", \"C\"))\nanswer <- nlevels(x)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "nlevels counts all declared levels, including unobserved ones."}
{"item_id": "BM1518", "position": 740, "batch": "2026-11-25_kc-c2_31", "anon_id": "M-31-021", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "sa <- 0.035; sb <- 0.045; d <- 0.025; z <- qnorm(0.995)\npw <- function(n) { s <- sqrt(sa^2/n + sb^2/n); pnorm((d - z*s)/s) + pnorm((-z*s - d)/s) }\nn <- 2\nwhile (pw(n) < 0.90) n <- n + 1\nanswer <- n", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Searches for the smallest n whose exact two-sided power is at least 0.90."}
