{"item_id": "BM0734", "position": 734, "batch": "2026-11-25_kc-c2_31", "anon_id": "M-31-015", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "names(Filter(function(v) length(v) > 2, x))", "test_inputs": [{"kind": "question_data", "code": "x <- list(a = c(1, 2), b = c(3, 4, 5), c = c(6, 7, 8, 9))"}, {"kind": "variation", "code": "x <- list(p = 1:5, q = 1, r = c(2, 3, 4), s = numeric(0))"}, {"kind": "variation", "code": "set.seed(3); x <- setNames(lapply(c(1, 4, 2, 6, 3), function(k) rnorm(k)), c(\"u\", \"v\", \"w\", \"y\", \"z\"))"}, {"kind": "edge", "code": "x <- list(a = 1, b = c(1, 2))"}], "correct_options": [], "note": "Filter keeps the elements longer than 2, and names() extracts their names."}
