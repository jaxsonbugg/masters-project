{"item_id": "BM1529", "position": 757, "batch": "2026-11-25_kc-c2_32", "anon_id": "M-32-013", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "# rows = predicted, columns = actual\ncm <- matrix(c(45, 10, 15, 30), nrow = 2, dimnames = list(Predicted = c('Fail','Pass'), Actual = c('Fail','Pass')))\nprecision <- cm['Pass','Pass']/sum(cm['Pass',])\nspecificity <- cm['Fail','Fail']/sum(cm[,'Fail'])\nvalue <- c(precision = precision, specificity = specificity)\nanswer <- if (abs(precision - 0.75) < 1e-3 && abs(specificity - 0.818) < 1e-3) 'B' else 'C'", "answer_expression": "", "test_inputs": [], "correct_options": ["B"], "note": "Treat rows as predicted and columns as actual: precision = 30/40 = 0.75 and specificity = 45/55 = 0.818."}
