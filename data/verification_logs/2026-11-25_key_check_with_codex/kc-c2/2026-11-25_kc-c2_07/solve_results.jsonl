{"item_id": "BM0112", "position": 112, "batch": "2026-11-25_kc-c2_07", "anon_id": "M-07-006", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "n1 <- 20; n2 <- 20; m1 <- 8; m2 <- 12; s1 <- 4; s2 <- 4\nsp <- sqrt(((n1-1)*s1^2 + (n2-1)*s2^2)/(n1+n2-2))\nanswer <- (m2 - m1)/sp", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Uses the pooled-SD formula for Cohen's d given in the question."}
{"item_id": "BM0113", "position": 113, "batch": "2026-11-25_kc-c2_07", "anon_id": "M-07-007", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "x <- c(0.9, 1.1, 0.8, 1.2, 0.95)\nv <- cumprod(x)\nanswer <- max(v)/min(v)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Runs the code directly and takes max/min of the cumulative products."}
{"item_id": "BM0114", "position": 114, "batch": "2026-11-25_kc-c2_07", "anon_id": "M-07-008", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "det(M)", "test_inputs": [{"kind": "question_data", "code": "M <- matrix(c(5, 1, 1, 4), nrow = 2, byrow = TRUE)"}, {"kind": "variation", "code": "M <- matrix(c(9, 2.5, 2.5, 3), nrow = 2, byrow = TRUE)"}, {"kind": "variation", "code": "set.seed(3)\nA <- matrix(rnorm(4), 2)\nM <- crossprod(A) + diag(2)"}, {"kind": "edge", "code": "M <- matrix(c(4, 2, 2, 1), nrow = 2, byrow = TRUE)"}], "correct_options": [], "note": "Uses base R det() on the 2x2 covariance matrix."}
{"item_id": "BM0115", "position": 115, "batch": "2026-11-25_kc-c2_07", "anon_id": "M-07-009", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "tcut <- 50/45\nanswer <- punif(tcut, 0.8, 1.2)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "R > 45 is the same as T < 50/45, so the answer is the uniform CDF at that value."}
