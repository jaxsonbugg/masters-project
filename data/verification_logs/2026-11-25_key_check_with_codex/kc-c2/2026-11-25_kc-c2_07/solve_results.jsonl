{"item_id": "BM0123", "position": 123, "batch": "2026-11-25_kc-c2_07", "anon_id": "M-07-017", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "residuals(fit, type = \"pearson\")", "test_inputs": [{"kind": "question_data", "code": "age <- c(20, 30, 40, 50, 60)\ncount <- c(2, 5, 7, 9, 12)\nfit <- glm(count ~ age, family = poisson)"}, {"kind": "variation", "code": "set.seed(5)\nage <- seq(18, 75, length.out = 12)\ncount <- rpois(12, exp(0.5 + 0.03*age))\nfit <- glm(count ~ age, family = poisson)"}, {"kind": "variation", "code": "age <- c(22, 35, 41, 48, 55, 63, 70)\ncount <- c(1, 3, 2, 6, 8, 7, 11)\nfit <- glm(count ~ age, family = poisson)"}, {"kind": "edge", "code": "age <- c(20, 30, 40, 50, 60)\ncount <- c(0, 1, 0, 2, 3)\nfit <- glm(count ~ age, family = poisson)"}], "correct_options": [], "note": "Uses residuals.glm with type = \"pearson\"."}
