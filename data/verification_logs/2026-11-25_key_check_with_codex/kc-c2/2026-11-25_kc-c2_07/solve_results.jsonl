{"item_id": "BM1190", "position": 118, "batch": "2026-11-25_kc-c2_07", "anon_id": "M-07-012", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "backsolve(chol(H), forwardsolve(t(chol(H)), -g))", "test_inputs": [{"kind": "variation", "code": "H <- matrix(c(4, 1, 1, 3), 2, 2)\ng <- c(1, -2)"}, {"kind": "variation", "code": "set.seed(10)\nA <- matrix(rnorm(25), 5)\nH <- crossprod(A) + diag(5)\ng <- rnorm(5)"}, {"kind": "variation", "code": "set.seed(20)\nA <- matrix(rnorm(9), 3)\nH <- crossprod(A) + 0.5 * diag(3)\ng <- c(0.3, -1.2, 2)"}, {"kind": "edge", "code": "H <- matrix(2.5, 1, 1)\ng <- 4"}], "correct_options": [], "note": "Since H = R'R, solve R'y = -g by forward substitution, then R delta = y by back substitution; the question gives no data."}
