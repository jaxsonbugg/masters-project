{"item_id": "BM0109", "position": 109, "batch": "2026-11-25_kc-c2_07", "anon_id": "M-07-003", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "sapply(df, function(v) sd(v) / mean(v))", "test_inputs": [{"kind": "question_data", "code": "df <- data.frame(x = c(1, 2, 3, 4, 5), y = c(10, 20, 30, 40, 50), z = c(5, 4, 3, 2, 1))"}, {"kind": "variation", "code": "set.seed(1)\ndf <- data.frame(a = rnorm(20, 10, 2), b = runif(20, 1, 5), c = rexp(20, 0.5))"}, {"kind": "variation", "code": "set.seed(42)\ndf <- data.frame(p = rpois(8, 6) + 1, q = rnorm(8, 50, 10))"}, {"kind": "edge", "code": "df <- data.frame(k = c(3, 3, 3, 3))"}], "correct_options": [], "note": "Applies sd/mean to each column with sapply, which returns a named numeric vector."}
{"item_id": "BM0110", "position": 110, "batch": "2026-11-25_kc-c2_07", "anon_id": "M-07-004", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "lower <- 0.004; upper <- 0.018\nvalue <- lower > 0 && upper > 0\nanswer <- if (value) \"C\" else if (upper < 0) \"B\" else \"A\"", "answer_expression": "", "test_inputs": [], "correct_options": ["C"], "note": "The 95% percentile interval lies entirely above zero, so A is higher."}
