{"item_id": "BM0125", "position": 125, "batch": "2026-11-25_kc-c2_07", "anon_id": "M-07-019", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "r1 <- c(1, 3, 5, 8, 9); r2 <- c(2, 4, 6, 7, 10, 11)\nU1 <- sum(r1) - length(r1)*(length(r1)+1)/2\nU2 <- sum(r2) - length(r2)*(length(r2)+1)/2\nanswer <- min(U1, U2)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Computes U for each group from its rank sum and takes the smaller value."}
