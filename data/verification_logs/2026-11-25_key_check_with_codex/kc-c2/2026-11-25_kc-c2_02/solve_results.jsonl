{"item_id": "BM0092", "position": 92, "batch": "2026-11-25_kc-c2_02", "anon_id": "M-02-003", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "A <- 1200\nanswer <- (0.95 * A + 15) - A", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Bias = E[A_hat] - A = 0.95A + 15 - A."}
{"item_id": "BM0108", "position": 108, "batch": "2026-11-25_kc-c2_02", "anon_id": "M-02-004", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "y <- c(12, 15, 11, 14, 13)\na <- 0.3\nF <- log(y[1])\nfor (t in 1:5) F <- a * log(y[t]) + (1 - a) * F\nanswer <- exp(F)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Applies the SES recursion on the log scale, then back-transforms."}
{"item_id": "BM0140", "position": 140, "batch": "2026-11-25_kc-c2_02", "anon_id": "M-02-005", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "n <- 20; s <- 0.018\nES <- s * sqrt(2/(n-1)) * exp(lgamma(n/2) - lgamma((n-1)/2))\nanswer <- ES - s", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Bias = E[S] - sigma, using the exact gamma formula."}
{"item_id": "BM0459", "position": 459, "batch": "2026-11-25_kc-c2_02", "anon_id": "M-02-006", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "x <- c(1, 2, 3, 4, 5)\ny <- c(2, 4, 5, 4, 5)\nm1 <- lm(y ~ x)\nm0 <- lm(y ~ 1)\nanswer <- AIC(m1) - AIC(m0)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Runs the given code."}
