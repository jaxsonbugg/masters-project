{"item_id": "BM0618", "position": 618, "batch": "2026-11-25_kc-c2_02", "anon_id": "M-02-018", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "sapply(split(x, g, drop = TRUE), length)", "test_inputs": [{"kind": "variation", "code": "x <- c(1.2, 3.4, 2.2, 5.1, 4.4); g <- factor(c(\"a\", \"b\", \"a\", \"b\", \"a\"), levels = c(\"a\", \"b\", \"c\"))"}, {"kind": "variation", "code": "set.seed(3); x <- rnorm(20); g <- factor(sample(c(\"lo\", \"mid\", \"hi\"), 20, replace = TRUE), levels = c(\"lo\", \"mid\", \"hi\", \"none\"))"}, {"kind": "variation", "code": "x <- c(10, 20, 30, 40, 50, 60); g <- factor(c(\"z\", \"y\", \"z\", \"y\", \"x\", \"z\"), levels = c(\"x\", \"y\", \"w\", \"z\"))"}, {"kind": "edge", "code": "x <- c(5, 6, 7); g <- factor(c(\"a\", \"a\", \"a\"), levels = c(\"a\", \"b\"))"}], "correct_options": [], "note": "split with drop = TRUE leaves out the unused level, and sapply(length) gives the named counts."}
