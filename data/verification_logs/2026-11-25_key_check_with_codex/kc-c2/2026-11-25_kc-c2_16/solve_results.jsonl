{"item_id": "BM0348", "position": 348, "batch": "2026-11-25_kc-c2_16", "anon_id": "M-16-012", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "x <- 12; n <- 60; z <- qnorm(0.975)\nnt <- n + z^2; pt <- (x + z^2/2)/nt\nanswer <- pt - z*sqrt(pt*(1-pt)/nt)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Agresti-Coull lower bound, using the formula given in the question."}
