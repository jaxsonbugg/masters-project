{"item_id": "BM1317", "position": 338, "batch": "2026-11-25_kc-c2_16", "anon_id": "M-16-003", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "sum(vapply(strsplit(x, \"|\", fixed = TRUE), function(s) sum(nzchar(s)), integer(1)))", "test_inputs": [{"kind": "question_data", "code": "x <- c('1.2|3.4|5.6', '7.8||9.0', '10.1|')"}, {"kind": "variation", "code": "x <- c('a|b', '|c|d|', 'e')"}, {"kind": "variation", "code": "x <- c('1||||2', '3|4|5|6', '|7')"}, {"kind": "edge", "code": "x <- c('', '|', '||')"}], "correct_options": [], "note": "Counts the non-empty pieces in each element with nzchar, using vapply, then adds them up without unlist."}
{"item_id": "BM0339", "position": 339, "batch": "2026-11-25_kc-c2_16", "anon_id": "M-16-004", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "f <- function(v) {\n  if (length(v) == 3) return(9.5)\n  sum(v) / length(v)\n}\nanswer <- f(c(2, 4, 6))", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Runs the code as given; the early return fires because the vector has length 3."}
{"item_id": "BM0340", "position": 340, "batch": "2026-11-25_kc-c2_16", "anon_id": "M-16-005", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "r <- 0.62; rho0 <- 0.40; n <- 50\nzr <- 0.5*log((1+r)/(1-r)); z0 <- 0.5*log((1+rho0)/(1-rho0))\nanswer <- (zr - z0)*sqrt(n-3)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Fisher z test against rho0 = 0.40."}
