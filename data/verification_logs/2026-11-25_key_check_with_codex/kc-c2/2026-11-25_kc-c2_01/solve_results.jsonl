{"item_id": "BM0092", "position": 92, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-003", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "A <- 1200\nanswer <- (0.95 * A + 15) - A", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Bias = E[A_hat] - A = 0.95A + 15 - A."}
{"item_id": "BM0108", "position": 108, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-004", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "y <- c(12, 15, 11, 14, 13)\nalpha <- 0.3\nF <- numeric(6)\nF[1] <- log(y[1])\nfor (t in 1:5) F[t + 1] <- alpha * log(y[t]) + (1 - alpha) * F[t]\nanswer <- exp(F[6])", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Runs the stated SES recursion on log counts, then exponentiates F_6."}
{"item_id": "BM0140", "position": 140, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-005", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "sigma <- 0.018; n <- 20\nES <- sigma * sqrt(2/(n - 1)) * exp(lgamma(n/2) - lgamma((n - 1)/2))\nanswer <- ES - sigma", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Bias = E[S] - sigma using the exact c4 formula."}
{"item_id": "BM0459", "position": 459, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-006", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "x <- c(1, 2, 3, 4, 5)\ny <- c(2, 4, 5, 4, 5)\nm1 <- lm(y ~ x)\nm0 <- lm(y ~ 1)\nanswer <- AIC(m1) - AIC(m0)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Evaluates the given code directly."}
