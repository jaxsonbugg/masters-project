{"item_id": "BM0820", "position": 820, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-008", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "n <- 20; s <- 400\nanswer <- 2 * s / qchisq(0.975, df = 2 * n)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Lower bound for mu is 2*sum divided by the upper chi-squared(2n) quantile."}
