{"item_id": "BM0009", "position": 9, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-016", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "model.matrix(~ type + temp, data = components)", "test_inputs": [{"kind": "question_data", "code": "components <- data.frame(life = c(120, 150, 130, 140, 160, 110), type = factor(c(\"X\", \"X\", \"Y\", \"Y\", \"X\", \"Y\")), temp = c(200, 200, 200, 250, 250, 250))"}, {"kind": "variation", "code": "set.seed(1)\ncomponents <- data.frame(life = round(rnorm(10, 140, 15)), type = factor(sample(c(\"X\", \"Y\"), 10, replace = TRUE), levels = c(\"X\", \"Y\")), temp = sample(c(200, 250, 300), 10, replace = TRUE))"}, {"kind": "variation", "code": "components <- data.frame(life = c(100, 125, 135, 145, 155, 165, 175, 105), type = factor(c(\"X\", \"Y\", \"Z\", \"X\", \"Y\", \"Z\", \"X\", \"Y\")), temp = c(180, 200, 220, 240, 260, 280, 300, 320))"}, {"kind": "edge", "code": "components <- data.frame(life = c(120, 150, 130), type = factor(c(\"X\", \"Y\", \"Y\")), temp = c(200, 200, 200))"}], "correct_options": [], "note": "Standard model.matrix call with treatment contrasts."}
{"item_id": "BM0158", "position": 158, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-017", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "as.integer(table(factor(a == b, levels = c(FALSE, TRUE)))[[\"TRUE\"]])", "test_inputs": [{"kind": "variation", "code": "a <- c(1L, 2L, 3L, 4L, 5L); b <- c(1L, 0L, 3L, 0L, 5L)"}, {"kind": "variation", "code": "set.seed(2); a <- sample(1:5, 30, replace = TRUE); b <- sample(1:5, 30, replace = TRUE)"}, {"kind": "edge", "code": "a <- c(1L, 2L, 3L); b <- c(4L, 5L, 6L)"}, {"kind": "edge", "code": "a <- c(7L, 7L, 7L, 7L); b <- c(7L, 7L, 7L, 7L)"}], "correct_options": [], "note": "Tabulates the logical equality with fixed levels so that zero matches returns 0."}
{"item_id": "BM0618", "position": 618, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-018", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "sapply(split(x, g, drop = TRUE), length)", "test_inputs": [{"kind": "variation", "code": "x <- c(1.2, 3.4, 2.2, 5.1, 4.4); g <- factor(c(\"a\", \"b\", \"a\", \"b\", \"a\"), levels = c(\"a\", \"b\", \"c\"))"}, {"kind": "variation", "code": "set.seed(3); x <- rnorm(20); g <- factor(sample(c(\"lo\", \"mid\", \"hi\"), 20, replace = TRUE), levels = c(\"lo\", \"mid\", \"hi\", \"none\"))"}, {"kind": "variation", "code": "x <- 1:8; g <- factor(c(\"z\", \"y\", \"z\", \"x\", \"x\", \"z\", \"y\", \"z\"), levels = c(\"u\", \"x\", \"y\", \"z\"))"}, {"kind": "edge", "code": "x <- c(2, 4, 6); g <- factor(c(\"a\", \"a\", \"a\"), levels = c(\"a\", \"b\"))"}], "correct_options": [], "note": "split with drop = TRUE removes the unused level before the counts are taken; the question gives no data, so all inputs are constructed."}
{"item_id": "BM0829", "position": 829, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-019", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "gsub(\"^([^:]*):(.*)$\", \"\\\\2:\\\\1\", v)", "test_inputs": [{"kind": "question_data", "code": "v <- c(\"A:1\", \"B:2\", \"C:3\")"}, {"kind": "variation", "code": "v <- c(\"X:9\", \"Y:8\", \"Z:7\", \"Q:0\")"}, {"kind": "variation", "code": "v <- c(\"D:4\", \"E:5\")"}, {"kind": "edge", "code": "v <- c(\"A:1\")"}], "correct_options": [], "note": "Uses backreferences to swap the parts before and after the colon."}
{"item_id": "BM0863", "position": 863, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-020", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "logs %in% critical", "test_inputs": [{"kind": "question_data", "code": "logs <- c(404, 500, 200, 500, 503); critical <- c(500, 503)"}, {"kind": "variation", "code": "set.seed(4); logs <- sample(c(200, 301, 404, 500, 502, 503), 15, replace = TRUE); critical <- c(500, 502, 503)"}, {"kind": "variation", "code": "logs <- c(200, 201, 404); critical <- c(404)"}, {"kind": "edge", "code": "logs <- c(200, 200, 301); critical <- c(500, 503)"}], "correct_options": [], "note": "%in% returns one logical value for each element of logs."}
{"item_id": "BM1743", "position": 458, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-021", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "c(table(factor(x, levels = L)))", "test_inputs": [{"kind": "question_data", "code": "x <- c('m', 'k', 'p', 'm', 'k'); L <- c('p', 'm', 'k', 'q')"}, {"kind": "variation", "code": "set.seed(5); x <- sample(c('a', 'b', 'c'), 12, replace = TRUE); L <- c('c', 'a', 'b', 'd', 'e')"}, {"kind": "variation", "code": "x <- c('z', 'y', 'z'); L <- c('y', 'z')"}, {"kind": "edge", "code": "x <- c('m', 'm'); L <- c('q', 'r')"}], "correct_options": [], "note": "Setting the factor levels to L forces L's order and gives zero counts for absent levels; c() turns the result into a named integer vector."}
{"item_id": "BM0213", "position": 213, "batch": "2026-11-25_kc-c2_01", "anon_id": "M-01-022", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "y <- c(10, 15, 12, 20, 25, 22)\nx <- c(1, 2, 3, 4, 5, 6)\ngroup <- factor(c(\"A\", \"A\", \"A\", \"B\", \"B\", \"B\"), levels = c(\"A\", \"B\", \"C\"))\nm <- lm(y ~ x + group)\nanswer <- paste(names(coef(m)), collapse = \" \")", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Runs the code; the unused level C keeps an NA coefficient named groupC."}
