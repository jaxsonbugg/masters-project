{"item_id": "BM0549", "position": 549, "batch": "2026-11-25_kc-c2_24", "anon_id": "M-24-009", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "rbind(cbind(approval, spending), colSums(cbind(approval, spending)))", "test_inputs": [{"kind": "question_data", "code": "approval <- c(1, 0, 1, 1, 0); spending <- c(520, 410, 580, 490, 370)"}, {"kind": "variation", "code": "set.seed(1); approval <- rbinom(8, 1, 0.5); spending <- round(runif(8, 300, 700))"}, {"kind": "variation", "code": "approval <- c(1, 1, 0); spending <- c(1000, 250.5, 730)"}, {"kind": "edge", "code": "approval <- 0; spending <- 0"}], "correct_options": [], "note": "Binds the two vectors as columns, then adds a row of column sums."}
{"item_id": "BM0550", "position": 550, "batch": "2026-11-25_kc-c2_24", "anon_id": "M-24-010", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "dev_drop <- 520.40 - 498.20\np <- pchisq(dev_drop, df = 2, lower.tail = FALSE)\nvalue <- p\nanswer <- if (p < 0.05) \"A\" else \"C\"", "answer_expression": "", "test_inputs": [], "correct_options": ["A"], "note": "Chi-square test on the drop in deviance with 2 df."}
