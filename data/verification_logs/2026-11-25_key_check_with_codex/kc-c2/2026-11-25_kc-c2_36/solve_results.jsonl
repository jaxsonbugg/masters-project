{"item_id": "BM0848", "position": 848, "batch": "2026-11-25_kc-c2_36", "anon_id": "M-36-001", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "tab <- matrix(c(400,100,200,300), nrow=2, byrow=TRUE, dimnames=list(c('High','Low'), c('Rapid','Delayed')))\np <- tab/sum(tab)\npLow <- sum(p['Low',])\npRapid <- sum(p[,'Rapid'])\npHR <- p['High','Rapid']\nnum <- pRapid^2 - pHR^2\nden <- 1 - (1 - pLow)^2\nanswer <- num/den", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "P(both rapid and at least one low) = P(both rapid) - P(both high-rapid), divided by P(at least one low)."}
{"item_id": "BM0849", "position": 849, "batch": "2026-11-25_kc-c2_36", "anon_id": "M-36-002", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "{set.seed(42); mean(rnorm(10000) > 1)}", "test_inputs": [{"kind": "question_data", "code": "invisible(NULL)"}], "correct_options": [], "note": "Only one test applies because the seed and sample size are fixed and there are no variable inputs."}
{"item_id": "BM0850", "position": 850, "batch": "2026-11-25_kc-c2_36", "anon_id": "M-36-003", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "p <- c(x=0.1226, group=0.1881, int=0.0061)\nvalue <- p < 0.05\nanswer <- if (value['int'] && !value['x'] && !value['group']) 'B' else if (value['x']) 'A' else 'C'", "answer_expression": "", "test_inputs": [], "correct_options": ["B"], "note": "Compared each p-value with 0.05: only the interaction is significant."}
{"item_id": "BM0851", "position": 851, "batch": "2026-11-25_kc-c2_36", "anon_id": "M-36-004", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "not_applicable", "r_code": "", "answer_expression": "", "test_inputs": [], "correct_options": ["C"], "note": "This is conceptual: the jackknife is consistent for smooth statistics, and fails for non-smooth ones such as the median."}
{"item_id": "BM0852", "position": 852, "batch": "2026-11-25_kc-c2_36", "anon_id": "M-36-005", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "n<-8;sT<-160;sR<-240;sT2<-3400;sR2<-7800;sTR<-5000\nSxy<-sTR-sT*sR/n;Sxx<-sT2-sT^2/n;Syy<-sR2-sR^2/n\nanswer<-Sxy/sqrt(Sxx*Syy)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Pearson r computed from the corrected sums of squares and cross-products."}
{"item_id": "BM1568", "position": 853, "batch": "2026-11-25_kc-c2_36", "anon_id": "M-36-006", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "set.seed(123)\ndf <- data.frame(g = factor(rep(c('A','B','C'), length.out = 100)), x = rnorm(100))\nmm <- model.matrix(~ g * x - 1, data = df)\nanswer <- ncol(mm)", "answer_expression": "", "test_inputs": [], "correct_options": [], "note": "Runs the code given in the question directly."}
{"item_id": "BM0854", "position": 854, "batch": "2026-11-25_kc-c2_36", "anon_id": "M-36-007", "kind": "solve-compute", "role": "C2", "model": "claude-opus-5-5", "status": "computed", "r_code": "", "answer_expression": "table(logs$plan)", "test_inputs": [{"kind": "question_data", "code": "logs <- data.frame(plan = c('Basic', 'Basic', 'Plus', 'Plus', 'Plus', 'Basic'), minutes = c(10, 5, 20, 22, 18, 8))"}, {"kind": "variation", "code": "set.seed(1); logs <- data.frame(plan = sample(c('Basic','Plus','Premium'), 30, replace=TRUE), minutes = round(runif(30, 1, 60)))"}, {"kind": "variation", "code": "logs <- data.frame(plan = c('Gold','Silver','Gold','Bronze','Silver','Gold','Bronze'), minutes = c(3,4,5,6,7,8,9))"}, {"kind": "edge", "code": "logs <- data.frame(plan = c('Basic','Basic','Basic'), minutes = c(1,2,3))"}], "correct_options": [], "note": "Uses table() on the plan column to count rows per plan."}
