{"item_id": "BM0134", "position": 134, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-001", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "lapply(load_ms, function(x) c(x - 5, x + 5))", "what_is_wrong": "returns a list, not a matrix", "counterexample": "load_ms <- c(120, 85, 150, 95)"}, {"expression": "sapply(load_ms, function(x) c(x + 5, x - 5))", "what_is_wrong": "rows in the wrong order", "counterexample": "load_ms <- c(120, 85, 150, 95)"}, {"expression": "t(sapply(load_ms, function(x) c(x - 5, x + 5)))", "what_is_wrong": "transposed to 4-by-2", "counterexample": "load_ms <- c(120, 85, 150, 95)"}, {"expression": "sapply(load_ms, function(x) c(x - 5, x - 5))", "what_is_wrong": "subtracts 5 twice, never adds", "counterexample": "load_ms <- c(120, 85, 150, 95)"}]}
{"item_id": "BM0138", "position": 138, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-002", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "substr() does not accept negative positions, so substr(ci, 2, -2) returns empty strings. A correct key is substr(ci, 2, nchar(ci) - 1).", "variants": [{"expression": "substr(ci, 2, nchar(ci))", "what_is_wrong": "keeps the closing bracket", "counterexample": "ci <- c(\"[-0.5, 1.2]\", \"[0.03, 0.97]\")"}, {"expression": "substr(ci, 1, nchar(ci) - 1)", "what_is_wrong": "keeps the opening bracket", "counterexample": "ci <- c(\"[-0.5, 1.2]\", \"[0.03, 0.97]\")"}, {"expression": "substr(ci, 2, nchar(ci) - 2)", "what_is_wrong": "off by one, drops the last digit", "counterexample": "ci <- c(\"[-0.5, 1.2]\", \"[0.03, 0.97]\")"}, {"expression": "substr(ci, 2, length(ci) - 1)", "what_is_wrong": "uses length instead of nchar", "counterexample": "ci <- c(\"[-0.5, 1.2]\", \"[0.03, 0.97]\")"}]}
{"item_id": "BM0143", "position": 143, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-003", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sort(unique(x))", "what_is_wrong": "sorts, so the original order is lost", "counterexample": "x <- c(3, 8, 3, 15, 8, 20)"}, {"expression": "x[!duplicated(x, fromLast = TRUE)]", "what_is_wrong": "keeps last occurrences, so the order changes", "counterexample": "x <- c(3, 8, 3, 15, 8, 20)"}, {"expression": "x[duplicated(x)]", "what_is_wrong": "returns only the duplicates", "counterexample": "x <- c(3, 8, 3, 15, 8, 20)"}, {"expression": "names(table(x))", "what_is_wrong": "character and sorted", "counterexample": "x <- c(3, 8, 3, 15, 8, 20)"}]}
{"item_id": "BM0149", "position": 149, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-004", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "solve(cbind(c(3,2),c(1,4)),c(10,10))", "what_is_wrong": "coefficient matrix transposed", "counterexample": "invisible(NULL)"}, {"expression": "solve(rbind(c(3,2),c(1,4)))", "what_is_wrong": "returns the inverse, not the solution", "counterexample": "invisible(NULL)"}, {"expression": "rbind(c(3,2),c(1,4)) %*% c(10,10)", "what_is_wrong": "multiplies instead of solving", "counterexample": "invisible(NULL)"}, {"expression": "solve(matrix(c(3,2,1,4),2),c(10,10))", "what_is_wrong": "matrix fills by column, so A is transposed", "counterexample": "invisible(NULL)"}]}
{"item_id": "BM0154", "position": 154, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-005", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "stays[order(stays$guests, stays$score), ]", "what_is_wrong": "guests sorted ascending", "counterexample": "stays <- data.frame(hotel = c(\"Pine\", \"Lake\", \"Peak\", \"Valley\"), guests = c(80, 80, 120, 60), score = c(4.1, 4.5, 4.2, 4.8))"}, {"expression": "stays[order(-stays$guests, -stays$score), ]", "what_is_wrong": "ties broken by score descending", "counterexample": "stays <- data.frame(hotel = c(\"Pine\", \"Lake\", \"Peak\", \"Valley\"), guests = c(80, 80, 120, 60), score = c(4.1, 4.5, 4.2, 4.8))"}, {"expression": "stays[rev(order(stays$guests, stays$score)), ]", "what_is_wrong": "reversing also reverses the tie-break", "counterexample": "stays <- data.frame(hotel = c(\"Pine\", \"Lake\", \"Peak\", \"Valley\"), guests = c(80, 80, 120, 60), score = c(4.1, 4.5, 4.2, 4.8))"}, {"expression": "sort(stays$guests, decreasing = TRUE)", "what_is_wrong": "returns a vector, not the data frame", "counterexample": "stays <- data.frame(hotel = c(\"Pine\", \"Lake\", \"Peak\", \"Valley\"), guests = c(80, 80, 120, 60), score = c(4.1, 4.5, 4.2, 4.8))"}]}
{"item_id": "BM0163", "position": 163, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-006", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "setNames(c(\"alpha\", \"beta\", \"gamma\"), c(10, 20, 30))", "what_is_wrong": "values and names swapped", "counterexample": "invisible(NULL)"}, {"expression": "list(alpha = 10, beta = 20, gamma = 30)", "what_is_wrong": "returns a list, not a numeric vector", "counterexample": "invisible(NULL)"}, {"expression": "setNames(c(10, 20, 30), c(\"alpha\", \"gamma\", \"beta\"))", "what_is_wrong": "names in the wrong order", "counterexample": "invisible(NULL)"}, {"expression": "c(10, 20, 30)", "what_is_wrong": "no names", "counterexample": "invisible(NULL)"}]}
{"item_id": "BM0169", "position": 169, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-007", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "cut(x, breaks = c(0, 7, 14, 20), labels = c(\"High\", \"Med\", \"Low\"), include.lowest = TRUE)", "what_is_wrong": "labels reversed", "counterexample": "x <- c(2, 8, 12, 19)"}, {"expression": "cut(x, breaks = c(0, 7, 14, 20), include.lowest = TRUE)", "what_is_wrong": "labels missing", "counterexample": "x <- c(2, 8, 12, 19)"}, {"expression": "cut(x, breaks = c(0, 8, 14, 20), labels = c(\"Low\", \"Med\", \"High\"), include.lowest = TRUE)", "what_is_wrong": "wrong break value", "counterexample": "x <- c(2, 8, 12, 19)"}, {"expression": "cut(x, breaks = c(0, 7, 14, 20), labels = FALSE, include.lowest = TRUE)", "what_is_wrong": "returns integer codes, not a factor", "counterexample": "x <- c(2, 8, 12, 19)"}]}
{"item_id": "BM0174", "position": 174, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-008", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "cut(1:6, breaks = c(-Inf, 4.5, Inf), labels = c('high', 'low'))", "what_is_wrong": "labels swapped", "counterexample": "invisible(NULL)"}, {"expression": "cut(1:6, breaks = c(-Inf, 4.5, Inf))", "what_is_wrong": "labels missing", "counterexample": "invisible(NULL)"}, {"expression": "cut(1:6, breaks = 2, labels = c('low', 'high'))", "what_is_wrong": "number of breaks instead of the cutpoints", "counterexample": "invisible(NULL)"}, {"expression": "cut(1:6, breaks = c(-Inf, 3.5, Inf), labels = c('low', 'high'))", "what_is_wrong": "wrong cutpoint", "counterexample": "invisible(NULL)"}]}
{"item_id": "BM0178", "position": 178, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-009", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "tryCatch(loglik_nb(-0.5, 2.3, c(1, 2, 0, 3)), warning = function(e) -Inf)", "what_is_wrong": "catches warnings, not errors", "counterexample": "loglik_nb <- function(theta, size, x) { if (theta <= 0) stop(\"Theta must be positive\"); sum(dnbinom(x, size = size, mu = theta, log = TRUE)) }"}, {"expression": "tryCatch(loglik_nb(-0.5, 2.3, c(1, 2, 0, 3)), error = function(e) Inf)", "what_is_wrong": "returns +Inf", "counterexample": "loglik_nb <- function(theta, size, x) { if (theta <= 0) stop(\"Theta must be positive\"); sum(dnbinom(x, size = size, mu = theta, log = TRUE)) }"}, {"expression": "tryCatch(loglik_nb(-0.5, 2.3, c(1, 2, 0, 3)), error = function(e) NA)", "what_is_wrong": "returns NA, not -Inf", "counterexample": "loglik_nb <- function(theta, size, x) { if (theta <= 0) stop(\"Theta must be positive\"); sum(dnbinom(x, size = size, mu = theta, log = TRUE)) }"}, {"expression": "tryCatch(loglik_nb(-0.5, 2.3, c(1, 2, 0, 3)), finally = -Inf)", "what_is_wrong": "finally does not handle the error", "counterexample": "loglik_nb <- function(theta, size, x) { if (theta <= 0) stop(\"Theta must be positive\"); sum(dnbinom(x, size = size, mu = theta, log = TRUE)) }"}]}
{"item_id": "BM0183", "position": 183, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-010", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "mean(time <= 9)", "what_is_wrong": "not strict inequality", "counterexample": "time <- c(7, 10, 8, 12, 9)"}, {"expression": "sum(time < 9)", "what_is_wrong": "count, not proportion", "counterexample": "time <- c(7, 10, 8, 12, 9)"}, {"expression": "mean(time[time < 9])", "what_is_wrong": "mean of the times, not a proportion", "counterexample": "time <- c(7, 10, 8, 12, 9)"}, {"expression": "length(time < 9) / length(time)", "what_is_wrong": "length of the logical vector is always n", "counterexample": "time <- c(7, 10, 8, 12, 9)"}]}
{"item_id": "BM0189", "position": 189, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-011", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sum((hours - mean(hours))^2) / length(hours)", "what_is_wrong": "denominator n instead of n - 1", "counterexample": "hours <- c(48.2, 47.5, 49.1, 48.0, 47.8)"}, {"expression": "sum((hours - mean(hours))^2) / length(hours) - 1", "what_is_wrong": "missing parentheses on the denominator", "counterexample": "hours <- c(48.2, 47.5, 49.1, 48.0, 47.8)"}, {"expression": "sqrt(sum((hours - mean(hours))^2) / (length(hours) - 1))", "what_is_wrong": "standard deviation, not variance", "counterexample": "hours <- c(48.2, 47.5, 49.1, 48.0, 47.8)"}, {"expression": "sum(hours - mean(hours))^2 / (length(hours) - 1)", "what_is_wrong": "squares after summing", "counterexample": "hours <- c(48.2, 47.5, 49.1, 48.0, 47.8)"}]}
{"item_id": "BM0194", "position": 194, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-012", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "mean(rbinom(10000, size = 5, prob = 0.4) > 3)", "what_is_wrong": "strict inequality excludes 3", "counterexample": "set.seed(42)"}, {"expression": "sum(rbinom(10000, size = 5, prob = 0.4) >= 3)", "what_is_wrong": "count, not probability", "counterexample": "set.seed(42)"}, {"expression": "mean(rbinom(5, size = 10000, prob = 0.4) >= 3)", "what_is_wrong": "n and size swapped", "counterexample": "set.seed(42)"}, {"expression": "1 - pbinom(2, 5, 0.4)", "what_is_wrong": "exact probability, no simulation", "counterexample": "set.seed(42)"}]}
{"item_id": "BM0198", "position": 198, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-013", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "apply(P, 1, function(r) dbeta(0.6, r[1], r[2]))", "what_is_wrong": "density, not the log-likelihood", "counterexample": "P <- rbind(c(0.2, 0.8), c(0.5, 0.5), c(0.7, 0.3))"}, {"expression": "apply(P, 2, function(r) dbeta(0.6, r[1], r[2], log=TRUE))", "what_is_wrong": "applies over columns", "counterexample": "P <- rbind(c(0.2, 0.8), c(0.5, 0.5), c(0.7, 0.3))"}, {"expression": "apply(P, 1, function(r) dbeta(0.6, r[2], r[1], log=TRUE))", "what_is_wrong": "alpha and beta swapped", "counterexample": "P <- rbind(c(0.2, 0.8), c(0.5, 0.5), c(0.7, 0.3))"}, {"expression": "apply(P, 1, function(r) pbeta(0.6, r[1], r[2], log=TRUE))", "what_is_wrong": "CDF instead of density", "counterexample": "P <- rbind(c(0.2, 0.8), c(0.5, 0.5), c(0.7, 0.3))"}]}
{"item_id": "BM0203", "position": 203, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-014", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "grep(\"data\", x)", "what_is_wrong": "returns indices, not logical", "counterexample": "x <- c(\"data_a\", \"data_b\", \"control_a\", \"data_c\")"}, {"expression": "x == \"data\"", "what_is_wrong": "exact match, not containment", "counterexample": "x <- c(\"data_a\", \"data_b\", \"control_a\", \"data_c\")"}, {"expression": "grepl(x, \"data\")", "what_is_wrong": "pattern and text swapped", "counterexample": "x <- c(\"data_a\", \"data_b\", \"control_a\", \"data_c\")"}, {"expression": "regexpr(\"data\", x)", "what_is_wrong": "returns match positions, not logical", "counterexample": "x <- c(\"data_a\", \"data_b\", \"control_a\", \"data_c\")"}]}
{"item_id": "BM0209", "position": 209, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-015", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "length(table(x) == 3)", "what_is_wrong": "counts all levels", "counterexample": "x <- factor(c(\"A\", \"B\", \"A\", \"C\", \"B\", \"A\", \"C\", \"C\"))"}, {"expression": "which(table(x) == 3)", "what_is_wrong": "returns indices, not a count", "counterexample": "x <- factor(c(\"A\", \"B\", \"A\", \"C\", \"B\", \"A\", \"C\", \"C\"))"}, {"expression": "nlevels(x)", "what_is_wrong": "ignores the count condition", "counterexample": "x <- factor(c(\"A\", \"B\", \"A\", \"C\", \"B\", \"A\", \"C\", \"C\"))"}, {"expression": "sum(table(x) >= 3)", "what_is_wrong": "at least three instead of exactly three", "counterexample": "x <- factor(c(\"A\", \"B\", \"A\", \"C\", \"B\", \"A\", \"C\", \"C\", \"C\"))"}]}
{"item_id": "BM0214", "position": 214, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-016", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "M[lower.tri(M)]", "what_is_wrong": "below the diagonal", "counterexample": "M <- matrix(c(10, 20, 30, 40, 50, 60, 70, 80, 90), nrow = 3)"}, {"expression": "M[upper.tri(M, diag = TRUE)]", "what_is_wrong": "includes the diagonal", "counterexample": "M <- matrix(c(10, 20, 30, 40, 50, 60, 70, 80, 90), nrow = 3)"}, {"expression": "diag(M)", "what_is_wrong": "diagonal elements", "counterexample": "M <- matrix(c(10, 20, 30, 40, 50, 60, 70, 80, 90), nrow = 3)"}, {"expression": "t(M)[upper.tri(M)]", "what_is_wrong": "transposed, so it gives the lower triangle", "counterexample": "M <- matrix(c(10, 20, 30, 40, 50, 60, 70, 80, 90), nrow = 3)"}]}
{"item_id": "BM2015", "position": 218, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-017", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "reshape(w, direction = \"long\", idvar = \"id\", timevar = \"time\", varying = 2:3, sep = \"\")", "what_is_wrong": "omits y3", "counterexample": "w <- data.frame(id = 1:2, y1 = c(10, 20), y2 = c(15, 25), y3 = c(12, 22))"}, {"expression": "reshape(w, direction = \"long\", idvar = \"id\", timevar = \"time\", varying = 2:4, sep = \"_\")", "what_is_wrong": "wrong separator", "counterexample": "w <- data.frame(id = 1:2, y1 = c(10, 20), y2 = c(15, 25), y3 = c(12, 22))"}, {"expression": "reshape(w, direction = \"long\", idvar = \"id\", timevar = \"time\", varying = 1:3, sep = \"\")", "what_is_wrong": "off-by-one column indices", "counterexample": "w <- data.frame(id = 1:2, y1 = c(10, 20), y2 = c(15, 25), y3 = c(12, 22))"}, {"expression": "reshape(w, direction = \"wide\", idvar = \"id\", timevar = \"time\", varying = 2:4, sep = \"\")", "what_is_wrong": "wrong direction", "counterexample": "w <- data.frame(id = 1:2, y1 = c(10, 20), y2 = c(15, 25), y3 = c(12, 22))"}]}
{"item_id": "BM0223", "position": 223, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-018", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "predict(fit, newdata = data.frame(x = 3))", "what_is_wrong": "link scale (log-odds)", "counterexample": "x <- 1:5; y <- c(0, 0, 1, 1, 1); d <- data.frame(x, y); fit <- suppressWarnings(glm(y ~ x, data = d, family = binomial))"}, {"expression": "predict(fit, type = 'response')", "what_is_wrong": "no newdata, so it returns all fitted values", "counterexample": "x <- 1:5; y <- c(0, 0, 1, 1, 1); d <- data.frame(x, y); fit <- suppressWarnings(glm(y ~ x, data = d, family = binomial))"}, {"expression": "exp(predict(fit, newdata = data.frame(x = 3)))", "what_is_wrong": "odds, not probability", "counterexample": "x <- 1:5; y <- c(0, 0, 1, 1, 1); d <- data.frame(x, y); fit <- suppressWarnings(glm(y ~ x, data = d, family = binomial))"}, {"expression": "coef(fit)[1] + 3 * coef(fit)[2]", "what_is_wrong": "linear predictor, not probability", "counterexample": "x <- 1:5; y <- c(0, 0, 1, 1, 1); d <- data.frame(x, y); fit <- suppressWarnings(glm(y ~ x, data = d, family = binomial))"}]}
{"item_id": "BM0229", "position": 229, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-019", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "paste(camp, \": \", ctr * 100, \"%\")", "what_is_wrong": "paste adds extra spaces", "counterexample": "camp <- c(\"spring_email\", \"summer_web\"); ctr <- c(0.045, 0.072)"}, {"expression": "paste0(camp, \": \", ctr, \"%\")", "what_is_wrong": "not multiplied by 100", "counterexample": "camp <- c(\"spring_email\", \"summer_web\"); ctr <- c(0.045, 0.072)"}, {"expression": "paste0(camp, \":\", ctr * 100, \"%\")", "what_is_wrong": "missing space after the colon", "counterexample": "camp <- c(\"spring_email\", \"summer_web\"); ctr <- c(0.045, 0.072)"}, {"expression": "paste0(camp, \": \", ctr * 100, \"%\", collapse = \", \")", "what_is_wrong": "collapses to a single string", "counterexample": "camp <- c(\"spring_email\", \"summer_web\"); ctr <- c(0.045, 0.072)"}]}
{"item_id": "BM0234", "position": 234, "batch": "2026-11-25_kc-variants_03", "anon_id": "V-03-020", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "lapply(L, length)", "what_is_wrong": "length instead of sum", "counterexample": "L <- list(a = c(2, 4, 6), b = c(10, 20), c = c(5, 5))"}, {"expression": "lapply(L, mean)", "what_is_wrong": "mean instead of sum", "counterexample": "L <- list(a = c(2, 4, 6), b = c(10, 20), c = c(5, 5))"}, {"expression": "sum(unlist(L))", "what_is_wrong": "grand total, not per component", "counterexample": "L <- list(a = c(2, 4, 6), b = c(10, 20), c = c(5, 5))"}, {"expression": "sapply(L, sum)", "what_is_wrong": "returns a vector, not a list", "counterexample": "L <- list(a = c(2, 4, 6), b = c(10, 20), c = c(5, 5))"}]}
