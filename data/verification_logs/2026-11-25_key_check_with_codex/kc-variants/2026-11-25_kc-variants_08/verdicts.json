{"variants": [{"id": "V-08-001", "key_concern": "", "variants": [{"expression": "ifelse(x >= 18, 0, x)", "what_is_wrong": "uses >= instead of strict >", "counterexample": "x <- c(18, 20)"}, {"expression": "ifelse(x > 18, x, 0)", "what_is_wrong": "yes/no branches swapped", "counterexample": "x <- c(10, 15, 20, 25, 30)"}, {"expression": "ifelse(x < 18, 0, x)", "what_is_wrong": "comparison direction reversed", "counterexample": "x <- c(10, 15, 20, 25, 30)"}, {"expression": "ifelse(x > 18, 0, NA)", "what_is_wrong": "other elements set to NA instead of kept", "counterexample": "x <- c(10, 15, 20, 25, 30)"}]}, {"id": "V-08-002", "key_concern": "", "variants": [{"expression": "var(replicate(10000, cor(rnorm(20), rnorm(20))))", "what_is_wrong": "variance instead of standard deviation", "counterexample": "set.seed(1)"}, {"expression": "mean(replicate(10000, cor(rnorm(20), rnorm(20))))", "what_is_wrong": "mean instead of sd", "counterexample": "set.seed(1)"}, {"expression": "sd(replicate(10000, cov(rnorm(20), rnorm(20))))", "what_is_wrong": "covariance instead of correlation", "counterexample": "set.seed(1)"}, {"expression": "sd(replicate(20, cor(rnorm(10000), rnorm(10000))))", "what_is_wrong": "replications and sample size swapped", "counterexample": "set.seed(1)"}]}, {"id": "V-08-003", "key_concern": "", "variants": [{"expression": "scale(x, scale = FALSE)", "what_is_wrong": "only centers, does not scale", "counterexample": "x <- c(1, 2, 3, 10)"}, {"expression": "scale(x, center = FALSE)", "what_is_wrong": "does not center; divides by root mean square", "counterexample": "x <- c(1, 2, 3, 10)"}, {"expression": "scale(x, center = median(x))", "what_is_wrong": "centers at median instead of mean", "counterexample": "x <- c(1, 2, 3, 10)"}, {"expression": "scale(x, scale = var(x))", "what_is_wrong": "divides by variance instead of sd", "counterexample": "x <- c(1, 2, 3, 10)"}]}, {"id": "V-08-004", "key_concern": "", "variants": [{"expression": "-2 * -312.7 + 2 * 3", "what_is_wrong": "computes AIC instead of BIC", "counterexample": "invisible(NULL)"}, {"expression": "-2 * -312.7 + 3 * log10(450)", "what_is_wrong": "base-10 log instead of natural log", "counterexample": "invisible(NULL)"}, {"expression": "2 * -312.7 + 3 * log(450)", "what_is_wrong": "sign of log-likelihood term wrong", "counterexample": "invisible(NULL)"}, {"expression": "-312.7 + 3 * log(450)", "what_is_wrong": "missing factor -2 on log-likelihood", "counterexample": "invisible(NULL)"}, {"expression": "-2 * -312.7 + 450 * log(3)", "what_is_wrong": "n and k swapped in penalty", "counterexample": "invisible(NULL)"}]}, {"id": "V-08-005", "key_concern": "", "variants": [{"expression": "parts[sample(ncol(parts)), ]", "what_is_wrong": "samples using number of columns, drops rows", "counterexample": "parts <- data.frame(id = 1:5, length_mm = c(10.1, 10.3, 9.9, 10.0, 10.2), defects = c(0, 1, 0, 2, 0)); set.seed(1)"}, {"expression": "parts[, sample(ncol(parts))]", "what_is_wrong": "shuffles columns instead of rows", "counterexample": "parts <- data.frame(id = 1:5, length_mm = c(10.1, 10.3, 9.9, 10.0, 10.2), defects = c(0, 1, 0, 2, 0)); set.seed(1)"}, {"expression": "parts[sample(nrow(parts), replace = TRUE), ]", "what_is_wrong": "samples with replacement (bootstrap) not a permutation", "counterexample": "parts <- data.frame(id = 1:5, length_mm = c(10.1, 10.3, 9.9, 10.0, 10.2), defects = c(0, 1, 0, 2, 0)); set.seed(1)"}, {"expression": "parts[sample(nrow(parts), 1), ]", "what_is_wrong": "returns only one random row", "counterexample": "parts <- data.frame(id = 1:5, length_mm = c(10.1, 10.3, 9.9, 10.0, 10.2), defects = c(0, 1, 0, 2, 0)); set.seed(1)"}]}, {"id": "V-08-006", "key_concern": "", "variants": [{"expression": "mapply(function(m, a) binom.test(m, a, p = 0.5, alternative = \"greater\")$p.value, made, attempts)", "what_is_wrong": "one-sided instead of two-sided test", "counterexample": "made <- c(4, 12, 7, 2, 9); attempts <- c(10, 20, 15, 5, 18)"}, {"expression": "mapply(function(m, a) prop.test(m, a, p = 0.5)$p.value, made, attempts)", "what_is_wrong": "approximate chi-square test, not exact", "counterexample": "made <- c(4, 12, 7, 2, 9); attempts <- c(10, 20, 15, 5, 18)"}, {"expression": "mapply(function(m, a) 2 * pbinom(m, a, 0.5), made, attempts)", "what_is_wrong": "doubles lower tail regardless of direction; can exceed 1", "counterexample": "made <- c(4, 12, 7, 2, 9); attempts <- c(10, 20, 15, 5, 18)"}, {"expression": "mapply(function(m, a) dbinom(m, a, 0.5), made, attempts)", "what_is_wrong": "point probability not p-value", "counterexample": "made <- c(4, 12, 7, 2, 9); attempts <- c(10, 20, 15, 5, 18)"}]}, {"id": "V-08-007", "key_concern": "", "variants": [{"expression": "length(strsplit(v, ','))", "what_is_wrong": "counts list elements not fragments", "counterexample": "v <- c('x,y', 'z', 'a,b,c')"}, {"expression": "lengths(strsplit(v, ','))", "what_is_wrong": "per-element counts, not total", "counterexample": "v <- c('x,y', 'z', 'a,b,c')"}, {"expression": "sum(nchar(v))", "what_is_wrong": "counts characters", "counterexample": "v <- c('x,y', 'z', 'a,b,c')"}, {"expression": "sum(lengths(strsplit(v, '')))", "what_is_wrong": "splits into single characters instead of by comma", "counterexample": "v <- c('x,y', 'z', 'a,b,c')"}]}, {"id": "V-08-008", "key_concern": "", "variants": [{"expression": "relevel(allele, ref = \"A\")", "what_is_wrong": "wrong reference level", "counterexample": "allele <- factor(c(\"A\", \"C\", \"G\", \"T\"))"}, {"expression": "factor(allele, levels = rev(levels(allele)))", "what_is_wrong": "reverses levels; G not first", "counterexample": "allele <- factor(c(\"A\", \"C\", \"G\", \"T\"))"}, {"expression": "factor(allele, levels = c(\"G\", \"T\", \"C\", \"A\"))", "what_is_wrong": "other levels' relative order changed", "counterexample": "allele <- factor(c(\"A\", \"C\", \"G\", \"T\"))"}, {"expression": "levels(relevel(allele, ref = \"G\"))", "what_is_wrong": "returns levels vector, not factor", "counterexample": "allele <- factor(c(\"A\", \"C\", \"G\", \"T\"))"}]}, {"id": "V-08-009", "key_concern": "", "variants": [{"expression": "rbind(c(1, 2, 3), c(4, 5, 6))", "what_is_wrong": "produces 2 by 3 matrix", "counterexample": "invisible(NULL)"}, {"expression": "cbind(c(1, 2, 3, 4, 5, 6))", "what_is_wrong": "6 by 1 matrix", "counterexample": "invisible(NULL)"}, {"expression": "cbind(c(1, 4), c(2, 5), c(3, 6))", "what_is_wrong": "2 by 3 matrix with wrong layout", "counterexample": "invisible(NULL)"}, {"expression": "cbind(c(4, 5, 6), c(1, 2, 3))", "what_is_wrong": "columns in wrong order", "counterexample": "invisible(NULL)"}]}, {"id": "V-08-010", "key_concern": "", "variants": [{"expression": "df[, cols]", "what_is_wrong": "drops to a vector when one column selected", "counterexample": "df <- data.frame(a = 1:3, b = 4:6); cols <- \"a\""}, {"expression": "df[, cols, drop = TRUE]", "what_is_wrong": "drop set to TRUE", "counterexample": "df <- data.frame(a = 1:3, b = 4:6); cols <- \"a\""}, {"expression": "df[cols, , drop = FALSE]", "what_is_wrong": "selects rows instead of columns", "counterexample": "df <- data.frame(a = 1:3, b = 4:6); cols <- \"a\""}, {"expression": "df[[cols]]", "what_is_wrong": "extracts a vector, not a data frame", "counterexample": "df <- data.frame(a = 1:3, b = 4:6); cols <- \"a\""}]}, {"id": "V-08-011", "key_concern": "", "variants": [{"expression": "coef(lm(am ~ wt, data = mtcars))[\"wt\"]", "what_is_wrong": "linear not logistic regression", "counterexample": "invisible(NULL)"}, {"expression": "coef(glm(am ~ wt, data = mtcars))[\"wt\"]", "what_is_wrong": "family omitted, defaults to gaussian", "counterexample": "invisible(NULL)"}, {"expression": "coef(glm(am ~ wt, data = mtcars, family = poisson))[\"wt\"]", "what_is_wrong": "wrong family", "counterexample": "invisible(NULL)"}, {"expression": "coef(glm(am ~ wt, data = mtcars, family = binomial))[1]", "what_is_wrong": "returns intercept", "counterexample": "invisible(NULL)"}, {"expression": "exp(coef(glm(am ~ wt, data = mtcars, family = binomial))[\"wt\"])", "what_is_wrong": "odds ratio instead of coefficient", "counterexample": "invisible(NULL)"}]}, {"id": "V-08-012", "key_concern": "", "variants": [{"expression": "Reduce(\"+\", c(10, 20, 30, 40), accumulate = TRUE)", "what_is_wrong": "returns cumulative sums vector", "counterexample": "invisible(NULL)"}, {"expression": "Reduce(\"*\", c(10, 20, 30, 40))", "what_is_wrong": "multiplication instead of addition", "counterexample": "invisible(NULL)"}, {"expression": "Reduce(\"-\", c(10, 20, 30, 40))", "what_is_wrong": "subtraction instead of addition", "counterexample": "invisible(NULL)"}, {"expression": "Reduce(\"+\", c(10, 20, 30, 40), 10)", "what_is_wrong": "spurious initial value added", "counterexample": "invisible(NULL)"}]}, {"id": "V-08-013", "key_concern": "", "variants": [{"expression": "which(cumsum(x) > 2.5)", "what_is_wrong": "returns all exceeding indices, not first", "counterexample": "x <- c(0.8, 1.5, -0.3, 2.1, 0.6, 1.2)"}, {"expression": "which(x > 2.5)[1]", "what_is_wrong": "uses raw deviations not cumulative sum", "counterexample": "x <- c(0.8, 1.5, -0.3, 2.1, 0.6, 1.2)"}, {"expression": "max(which(cumsum(x) > 2.5))", "what_is_wrong": "last exceedance instead of first", "counterexample": "x <- c(0.8, 1.5, -0.3, 2.1, 0.6, 1.2)"}, {"expression": "sum(cumsum(x) <= 2.5)", "what_is_wrong": "off by one: counts quarters before signal", "counterexample": "x <- c(0.8, 1.5, -0.3, 2.1, 0.6, 1.2)"}, {"expression": "cumsum(x)[cumsum(x) > 2.5][1]", "what_is_wrong": "returns statistic value, not index", "counterexample": "x <- c(0.8, 1.5, -0.3, 2.1, 0.6, 1.2)"}]}, {"id": "V-08-014", "key_concern": "", "variants": [{"expression": "sort(c(2, 5, 1, 8, 3))", "what_is_wrong": "not reversed", "counterexample": "x <- c(2, 5, 1, 8, 3)"}, {"expression": "rev(c(2, 5, 1, 8, 3))", "what_is_wrong": "reversed without sorting", "counterexample": "x <- c(2, 5, 1, 8, 3)"}, {"expression": "sort(rev(c(2, 5, 1, 8, 3)))", "what_is_wrong": "operations in wrong order", "counterexample": "x <- c(2, 5, 1, 8, 3)"}, {"expression": "rev(order(c(2, 5, 1, 8, 3)))", "what_is_wrong": "returns indices instead of values", "counterexample": "x <- c(2, 5, 1, 8, 3)"}]}, {"id": "V-08-015", "key_concern": "", "variants": [{"expression": "set.seed(42); mean(rnorm(10000) < 1)", "what_is_wrong": "wrong tail", "counterexample": "invisible(NULL)"}, {"expression": "set.seed(42); sum(rnorm(10000) > 1)", "what_is_wrong": "count instead of proportion", "counterexample": "invisible(NULL)"}, {"expression": "set.seed(42); mean(abs(rnorm(10000)) > 1)", "what_is_wrong": "two-sided exceedance", "counterexample": "invisible(NULL)"}, {"expression": "set.seed(42); mean(runif(10000) > 1)", "what_is_wrong": "uniform instead of normal draws", "counterexample": "invisible(NULL)"}]}, {"id": "V-08-016", "key_concern": "", "variants": [{"expression": "length(logs$plan)", "what_is_wrong": "total rows, not per plan", "counterexample": "logs <- data.frame(plan = c('Basic', 'Basic', 'Plus', 'Plus', 'Plus', 'Basic'), minutes = c(10, 5, 20, 22, 18, 8))"}, {"expression": "table(logs$minutes)", "what_is_wrong": "tabulates wrong column", "counterexample": "logs <- data.frame(plan = c('Basic', 'Basic', 'Plus', 'Plus', 'Plus', 'Basic'), minutes = c(10, 5, 20, 22, 18, 8))"}, {"expression": "tapply(logs$minutes, logs$plan, sum)", "what_is_wrong": "sums minutes instead of counting", "counterexample": "logs <- data.frame(plan = c('Basic', 'Basic', 'Plus', 'Plus', 'Plus', 'Basic'), minutes = c(10, 5, 20, 22, 18, 8))"}, {"expression": "length(unique(logs$plan))", "what_is_wrong": "counts distinct plans", "counterexample": "logs <- data.frame(plan = c('Basic', 'Basic', 'Plus', 'Plus', 'Plus', 'Basic'), minutes = c(10, 5, 20, 22, 18, 8))"}]}, {"id": "V-08-017", "key_concern": "", "variants": [{"expression": "intersect(enrolled, screened)", "what_is_wrong": "withdrawn not excluded", "counterexample": "enrolled <- c(\"P101\", \"P102\", \"P103\", \"P104\", \"P102\"); screened <- c(\"P102\", \"P103\", \"P105\", \"P101\"); withdrawn <- c(\"P103\", \"P107\")"}, {"expression": "setdiff(union(enrolled, screened), withdrawn)", "what_is_wrong": "union instead of intersection", "counterexample": "enrolled <- c(\"P101\", \"P102\", \"P103\", \"P104\", \"P102\"); screened <- c(\"P102\", \"P103\", \"P105\", \"P101\"); withdrawn <- c(\"P103\", \"P107\")"}, {"expression": "setdiff(intersect(screened, enrolled), withdrawn)", "what_is_wrong": "order follows screened, not enrolled", "counterexample": "enrolled <- c(\"P101\", \"P102\", \"P103\", \"P104\", \"P102\"); screened <- c(\"P102\", \"P103\", \"P105\", \"P101\"); withdrawn <- c(\"P103\", \"P107\")"}, {"expression": "enrolled[enrolled %in% screened & !enrolled %in% withdrawn]", "what_is_wrong": "keeps duplicate IDs", "counterexample": "enrolled <- c(\"P101\", \"P102\", \"P103\", \"P104\", \"P102\"); screened <- c(\"P102\", \"P103\", \"P105\", \"P101\"); withdrawn <- c(\"P103\", \"P107\")"}, {"expression": "setdiff(enrolled, withdrawn)", "what_is_wrong": "ignores screening requirement", "counterexample": "enrolled <- c(\"P101\", \"P102\", \"P103\", \"P104\", \"P102\"); screened <- c(\"P102\", \"P103\", \"P105\", \"P101\"); withdrawn <- c(\"P103\", \"P107\")"}]}, {"id": "V-08-018", "key_concern": "", "variants": [{"expression": "transform(df, flag = ifelse(value > 20, \"low\", \"high\"))", "what_is_wrong": "labels swapped", "counterexample": "df <- data.frame(id = 1:4, value = c(15, 22, 10, 30))"}, {"expression": "ifelse(df$value > 20, \"high\", \"low\")", "what_is_wrong": "returns vector, not data frame", "counterexample": "df <- data.frame(id = 1:4, value = c(15, 22, 10, 30))"}, {"expression": "transform(df, flag = value > 20)", "what_is_wrong": "logical flag instead of high/low", "counterexample": "df <- data.frame(id = 1:4, value = c(15, 22, 10, 30))"}, {"expression": "cbind(df, ifelse(df$value > 20, \"high\", \"low\"))", "what_is_wrong": "new column not named flag", "counterexample": "df <- data.frame(id = 1:4, value = c(15, 22, 10, 30))"}]}, {"id": "V-08-019", "key_concern": "", "variants": [{"expression": "tryCatch(rnorm(-1), error = function(e) \"42\")", "what_is_wrong": "returns character not numeric", "counterexample": "invisible(NULL)"}, {"expression": "tryCatch(rnorm(-1), warning = function(w) 42)", "what_is_wrong": "handles warning, error not caught", "counterexample": "invisible(NULL)"}, {"expression": "tryCatch(rnorm(-1), error = function(e) e)", "what_is_wrong": "returns condition object", "counterexample": "invisible(NULL)"}, {"expression": "tryCatch(rnorm(1), error = function(e) 42)", "what_is_wrong": "calls wrong expression", "counterexample": "set.seed(1)"}]}, {"id": "V-08-020", "key_concern": "", "variants": [{"expression": "(sum(x^2) - sum(x)^2 / length(x)) / length(x)", "what_is_wrong": "denominator n instead of n - 1", "counterexample": "x <- c(1, 2, 4)"}, {"expression": "(sum(x^2) - sum(x)^2) / (length(x) - 1)", "what_is_wrong": "missing division by n", "counterexample": "x <- c(1, 2, 4)"}, {"expression": "(sum(x^2) - sum(x^2) / length(x)) / (length(x) - 1)", "what_is_wrong": "uses sum(x^2) instead of sum(x)^2", "counterexample": "x <- c(1, 2, 4)"}, {"expression": "sqrt((sum(x^2) - sum(x)^2 / length(x)) / (length(x) - 1))", "what_is_wrong": "returns sd not variance", "counterexample": "x <- c(1, 2, 4)"}]}, {"id": "V-08-021", "key_concern": "", "variants": [{"expression": "mean(c(4, 5, 3, 6))", "what_is_wrong": "unweighted mean", "counterexample": "invisible(NULL)"}, {"expression": "weighted.mean(c(10, 20, 15, 5), c(4, 5, 3, 6))", "what_is_wrong": "values and weights swapped", "counterexample": "invisible(NULL)"}, {"expression": "sum(c(4, 5, 3, 6) * c(10, 20, 15, 5)) / 4", "what_is_wrong": "divides by number of departments", "counterexample": "invisible(NULL)"}, {"expression": "sum(c(4, 5, 3, 6) * c(10, 20, 15, 5))", "what_is_wrong": "no division by total weight", "counterexample": "invisible(NULL)"}]}, {"id": "V-08-022", "key_concern": "", "variants": [{"expression": "scale(x, scale = FALSE)", "what_is_wrong": "only centers", "counterexample": "x <- c(1, 2, 3, 10)"}, {"expression": "scale(x, center = FALSE)", "what_is_wrong": "does not subtract mean", "counterexample": "x <- c(1, 2, 3, 10)"}, {"expression": "scale(x, scale = var(x))", "what_is_wrong": "divides by variance", "counterexample": "x <- c(1, 2, 3, 10)"}, {"expression": "scale(x, center = median(x))", "what_is_wrong": "centers at median", "counterexample": "x <- c(1, 2, 3, 10)"}]}, {"id": "V-08-023", "key_concern": "", "variants": [{"expression": "sample(c(14, 19, 22, 27, 33), 3, replace = TRUE)", "what_is_wrong": "samples with replacement", "counterexample": "set.seed(1)"}, {"expression": "sample(c(14, 19, 22, 27, 33), 5)", "what_is_wrong": "selects all 5 values", "counterexample": "set.seed(1)"}, {"expression": "sample(1:5, 3)", "what_is_wrong": "returns indices not widths", "counterexample": "set.seed(1)"}, {"expression": "sample(c(14, 19, 22, 27, 33), 1)", "what_is_wrong": "selects only one value", "counterexample": "set.seed(1)"}]}, {"id": "V-08-024", "key_concern": "", "variants": [{"expression": "set.seed(42); rnbinom(500, size = 12, mu = 4)", "what_is_wrong": "uses variance as size", "counterexample": "invisible(NULL)"}, {"expression": "set.seed(42); rnbinom(500, size = 4, mu = 4)", "what_is_wrong": "wrong size (variance would be 8)", "counterexample": "invisible(NULL)"}, {"expression": "set.seed(42); rnbinom(500, size = 2, prob = 2/3)", "what_is_wrong": "wrong prob; mean becomes 1", "counterexample": "invisible(NULL)"}, {"expression": "set.seed(42); rpois(500, 4)", "what_is_wrong": "Poisson ignores overdispersion", "counterexample": "invisible(NULL)"}]}, {"id": "V-08-025", "key_concern": "", "variants": [{"expression": "sub(\"a\", \"0\", str_vec)", "what_is_wrong": "replaces only first occurrence", "counterexample": "str_vec <- c(\"test\", \"case\", \"data\")"}, {"expression": "gsub(\"0\", \"a\", str_vec)", "what_is_wrong": "pattern and replacement swapped", "counterexample": "str_vec <- c(\"test\", \"case\", \"data\")"}, {"expression": "gsub(\"a\", \"O\", str_vec)", "what_is_wrong": "letter O instead of zero", "counterexample": "str_vec <- c(\"test\", \"case\", \"data\")"}, {"expression": "gsub(\"a\", \"\", str_vec)", "what_is_wrong": "deletes instead of replacing", "counterexample": "str_vec <- c(\"test\", \"case\", \"data\")"}, {"expression": "gsub(\"[a-z]\", \"0\", str_vec)", "what_is_wrong": "replaces all letters", "counterexample": "str_vec <- c(\"test\", \"case\", \"data\")"}]}]}