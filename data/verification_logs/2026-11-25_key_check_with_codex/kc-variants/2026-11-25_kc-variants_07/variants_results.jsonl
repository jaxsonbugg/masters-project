{"item_id": "BM0649", "position": 649, "batch": "2026-11-25_kc-variants_07", "anon_id": "V-07-001", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sum(rpois(1000, 3) >= 5)", "what_is_wrong": "counts values at least 5 instead of exactly 5", "counterexample": "set.seed(123)"}, {"expression": "mean(rpois(1000, 3) == 5)", "what_is_wrong": "returns a proportion instead of a count", "counterexample": "set.seed(123)"}, {"expression": "rpois(1000, 3) == 5", "what_is_wrong": "returns a logical vector, not a count", "counterexample": "set.seed(123)"}, {"expression": "sum(rpois(1000, 1/3) == 5)", "what_is_wrong": "uses rate 1/3 instead of mean 3", "counterexample": "set.seed(123)"}]}
{"item_id": "BM0654", "position": 654, "batch": "2026-11-25_kc-variants_07", "anon_id": "V-07-002", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "aggregate(x ~ g, data = data.frame(x, g), FUN = mean)", "what_is_wrong": "computes only the mean, not the sum", "counterexample": "x <- c(10, 12, 8, 15, 11, 13); g <- factor(c('A', 'A', 'B', 'B', 'A', 'B'))"}, {"expression": "aggregate(x ~ g, data = data.frame(x, g), FUN = function(v) c(mean = mean(v), sum = length(v)))", "what_is_wrong": "uses length (count) instead of sum", "counterexample": "x <- c(10, 12, 8, 15, 11, 13); g <- factor(c('A', 'A', 'B', 'B', 'A', 'B'))"}, {"expression": "aggregate(x ~ g, data = data.frame(x, g), FUN = function(v) c(mean = median(v), sum = sum(v)))", "what_is_wrong": "uses median instead of mean", "counterexample": "x <- c(10, 12, 8, 15, 11, 13); g <- factor(c('A', 'A', 'B', 'B', 'A', 'B'))"}, {"expression": "aggregate(x ~ g, data = data.frame(x, g), FUN = sum)", "what_is_wrong": "computes only the sum, not the mean", "counterexample": "x <- c(10, 12, 8, 15, 11, 13); g <- factor(c('A', 'A', 'B', 'B', 'A', 'B'))"}]}
{"item_id": "BM0658", "position": 658, "batch": "2026-11-25_kc-variants_07", "anon_id": "V-07-003", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "c(coef(fit)['load'], vcov(fit)['load', 'load'])", "what_is_wrong": "returns the variance, not the standard error", "counterexample": "dat <- data.frame(load = c(10, 20, 15, 25, 30), temperature = c(20, 25, 30, 35, 40), log_hours = c(12.1, 10.5, 11.2, 9.8, 9.1)); fit <- lm(log_hours ~ load + temperature, data = dat)"}, {"expression": "c(coef(fit)[2], sqrt(vcov(fit)[1, 1]))", "what_is_wrong": "takes the intercept's SE instead of load's", "counterexample": "dat <- data.frame(load = c(10, 20, 15, 25, 30), temperature = c(20, 25, 30, 35, 40), log_hours = c(12.1, 10.5, 11.2, 9.8, 9.1)); fit <- lm(log_hours ~ load + temperature, data = dat)"}, {"expression": "c(coef(fit)['temperature'], sqrt(vcov(fit)['temperature', 'temperature']))", "what_is_wrong": "uses the wrong coefficient", "counterexample": "dat <- data.frame(load = c(10, 20, 15, 25, 30), temperature = c(20, 25, 30, 35, 40), log_hours = c(12.1, 10.5, 11.2, 9.8, 9.1)); fit <- lm(log_hours ~ load + temperature, data = dat)"}, {"expression": "c(coef(fit)[1], sqrt(diag(vcov(fit)))[1])", "what_is_wrong": "index 1 is the intercept, not load", "counterexample": "dat <- data.frame(load = c(10, 20, 15, 25, 30), temperature = c(20, 25, 30, 35, 40), log_hours = c(12.1, 10.5, 11.2, 9.8, 9.1)); fit <- lm(log_hours ~ load + temperature, data = dat)"}]}
{"item_id": "BM0663", "position": 663, "batch": "2026-11-25_kc-variants_07", "anon_id": "V-07-004", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "union(recent_listings, high_demand)", "what_is_wrong": "union instead of intersection", "counterexample": "recent_listings <- c(101, 102, 103, 104); high_demand <- c(102, 104, 105, 106)"}, {"expression": "setdiff(recent_listings, high_demand)", "what_is_wrong": "set difference instead of intersection", "counterexample": "recent_listings <- c(101, 102, 103, 104); high_demand <- c(102, 104, 105, 106)"}, {"expression": "recent_listings %in% high_demand", "what_is_wrong": "returns a logical vector, not IDs", "counterexample": "recent_listings <- c(101, 102, 103, 104); high_demand <- c(102, 104, 105, 106)"}, {"expression": "unique(c(recent_listings, high_demand))", "what_is_wrong": "combines all IDs instead of common ones", "counterexample": "recent_listings <- c(101, 102, 103, 104); high_demand <- c(102, 104, 105, 106)"}]}
{"item_id": "BM0669", "position": 669, "batch": "2026-11-25_kc-variants_07", "anon_id": "V-07-005", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "df[order(df$load_time, df$crashes),]", "what_is_wrong": "crashes sorted ascending instead of descending", "counterexample": "df <- data.frame(feature = c('Login', 'Feed', 'Search', 'Profile', 'Chat'), load_time = c(1.2, 2.5, 1.2, 3.1, 2.5), crashes = c(15, 4, 22, 8, 9))"}, {"expression": "df[order(-df$load_time, -df$crashes),]", "what_is_wrong": "load_time sorted descending", "counterexample": "df <- data.frame(feature = c('Login', 'Feed', 'Search', 'Profile', 'Chat'), load_time = c(1.2, 2.5, 1.2, 3.1, 2.5), crashes = c(15, 4, 22, 8, 9))"}, {"expression": "df[order(-df$crashes, df$load_time),]", "what_is_wrong": "sort keys in the wrong priority", "counterexample": "df <- data.frame(feature = c('Login', 'Feed', 'Search', 'Profile', 'Chat'), load_time = c(1.2, 2.5, 1.2, 3.1, 2.5), crashes = c(15, 4, 22, 8, 9))"}, {"expression": "df[order(df$load_time),]", "what_is_wrong": "ignores the crashes tie-breaker", "counterexample": "df <- data.frame(feature = c('Login', 'Feed', 'Search', 'Profile', 'Chat'), load_time = c(1.2, 2.5, 1.2, 3.1, 2.5), crashes = c(15, 4, 22, 8, 9))"}]}
