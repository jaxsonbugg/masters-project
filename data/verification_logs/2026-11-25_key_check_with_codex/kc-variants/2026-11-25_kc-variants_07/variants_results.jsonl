{"item_id": "BM0689", "position": 689, "batch": "2026-11-25_kc-variants_07", "anon_id": "V-07-009", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "table(loan_outcomes)", "what_is_wrong": "alphabetical order puts D before R", "counterexample": "loan_outcomes <- c(\"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"D\", \"D\", \"D\", \"D\", \"D\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\")"}, {"expression": "table(factor(loan_outcomes, labels = c(\"R\", \"D\")))", "what_is_wrong": "labels relabel sorted levels, mislabeling counts", "counterexample": "loan_outcomes <- c(\"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"D\", \"D\", \"D\", \"D\", \"D\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\")"}, {"expression": "table(factor(loan_outcomes, levels = c(\"D\", \"R\")))", "what_is_wrong": "wrong level order", "counterexample": "loan_outcomes <- c(\"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"D\", \"D\", \"D\", \"D\", \"D\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\")"}, {"expression": "table(loan_outcomes == \"R\")", "what_is_wrong": "FALSE/TRUE table with defaults first", "counterexample": "loan_outcomes <- c(\"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"D\", \"D\", \"D\", \"D\", \"D\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\", \"R\")"}]}
