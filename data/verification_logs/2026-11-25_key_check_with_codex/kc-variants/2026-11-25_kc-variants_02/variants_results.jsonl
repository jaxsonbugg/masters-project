{"item_id": "BM0098", "position": 98, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-019", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sd(colMeans(matrix(sample(p, length(p)*5000, replace=TRUE), nrow=5000)))", "what_is_wrong": "nrow instead of ncol, wrong resample layout", "counterexample": "set.seed(42); p <- c(1.2, 3.4, 2.2, 5.1, 4.0)"}, {"expression": "sd(p) / sqrt(length(p))", "what_is_wrong": "analytic SE, no bootstrap", "counterexample": "set.seed(42); p <- c(1.2, 3.4, 2.2, 5.1, 4.0)"}, {"expression": "var(colMeans(matrix(sample(p, length(p)*5000, replace=TRUE), ncol=5000)))", "what_is_wrong": "variance instead of standard deviation", "counterexample": "set.seed(42); p <- c(1.2, 3.4, 2.2, 5.1, 4.0)"}, {"expression": "sd(colMeans(matrix(sample(p, 5000, replace=TRUE), ncol=5000)))", "what_is_wrong": "resamples of size 1 instead of length(p)", "counterexample": "set.seed(42); p <- c(1.2, 3.4, 2.2, 5.1, 4.0)"}]}
