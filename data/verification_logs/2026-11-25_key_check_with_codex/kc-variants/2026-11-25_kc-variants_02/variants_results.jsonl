{"item_id": "BM0083", "position": 83, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-016", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "mean(x)", "what_is_wrong": "missing na.rm, returns NA", "counterexample": "x <- c(10, 20, NA, 30, NA, 40)"}, {"expression": "sum(x, na.rm = TRUE) / length(x)", "what_is_wrong": "denominator counts NAs", "counterexample": "x <- c(10, 20, NA, 30, NA, 40)"}, {"expression": "mean(is.na(x))", "what_is_wrong": "proportion missing instead of mean", "counterexample": "x <- c(10, 20, NA, 30, NA, 40)"}, {"expression": "sum(x, na.rm = TRUE)", "what_is_wrong": "sum instead of mean", "counterexample": "x <- c(10, 20, NA, 30, NA, 40)"}]}
{"item_id": "BM0089", "position": 89, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-017", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "range(rates)", "what_is_wrong": "returns min and max, not difference", "counterexample": "rates <- c(4.5, 5.1, 4.8, 5.3, 4.9)"}, {"expression": "rates[5] - rates[1]", "what_is_wrong": "last minus first, not max minus min", "counterexample": "rates <- c(4.5, 5.1, 4.8, 5.3, 4.9)"}, {"expression": "min(rates) - max(rates)", "what_is_wrong": "sign reversed", "counterexample": "rates <- c(4.5, 5.1, 4.8, 5.3, 4.9)"}, {"expression": "sd(rates)", "what_is_wrong": "standard deviation instead of range", "counterexample": "rates <- c(4.5, 5.1, 4.8, 5.3, 4.9)"}, {"expression": "max(rates) - mean(rates)", "what_is_wrong": "uses mean instead of min", "counterexample": "rates <- c(4.5, 5.1, 4.8, 5.3, 4.9)"}]}
