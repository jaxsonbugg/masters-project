{"item_id": "BM0003", "position": 3, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-001", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "months(x)", "what_is_wrong": "returns month name instead of weekday", "counterexample": "x <- as.Date('2024-06-15')"}, {"expression": "format(x, \"%u\")", "what_is_wrong": "returns weekday number as string, not weekday name", "counterexample": "x <- as.Date('2024-06-15')"}, {"expression": "as.POSIXlt(x)$wday", "what_is_wrong": "returns numeric day index, not a character weekday", "counterexample": "x <- as.Date('2024-06-15')"}, {"expression": "format(x, \"%d\")", "what_is_wrong": "returns day of month, not weekday", "counterexample": "x <- as.Date('2024-06-15')"}]}
{"item_id": "BM0014", "position": 14, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-002", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sum(rec_times[, 1])", "what_is_wrong": "sums first column (breed) instead of first row (clinic)", "counterexample": "rec_times <- matrix(c(5, 7, 6, 4, 8, 5), nrow = 2, byrow = TRUE)"}, {"expression": "sum(rec_times[1])", "what_is_wrong": "takes only the first element, not the first row", "counterexample": "rec_times <- matrix(c(5, 7, 6, 4, 8, 5), nrow = 2, byrow = TRUE)"}, {"expression": "mean(rec_times[1, ])", "what_is_wrong": "mean instead of total", "counterexample": "rec_times <- matrix(c(5, 7, 6, 4, 8, 5), nrow = 2, byrow = TRUE)"}, {"expression": "sum(rec_times)", "what_is_wrong": "sums all clinics", "counterexample": "rec_times <- matrix(c(5, 7, 6, 4, 8, 5), nrow = 2, byrow = TRUE)"}, {"expression": "rowSums(rec_times)", "what_is_wrong": "returns totals for both clinics, not just the first", "counterexample": "rec_times <- matrix(c(5, 7, 6, 4, 8, 5), nrow = 2, byrow = TRUE)"}]}
{"item_id": "BM0018", "position": 18, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-003", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "D[!duplicated(D[, c(\"y\", \"z\")]), ]", "what_is_wrong": "does not drop unused factor levels", "counterexample": "D <- data.frame(x = factor(c(\"a\", \"b\")), y = c(1, 1), z = c(1, 1))"}, {"expression": "droplevels(unique(D))", "what_is_wrong": "deduplicates on all columns, not just y and z", "counterexample": "D <- data.frame(x = factor(c(\"a\", \"b\")), y = c(1, 1), z = c(1, 1))"}, {"expression": "droplevels(D[!duplicated(D[, c(\"y\", \"z\")], fromLast = TRUE), ])", "what_is_wrong": "keeps last occurrence instead of first", "counterexample": "D <- data.frame(x = factor(c(\"a\", \"b\")), y = c(1, 1), z = c(1, 1))"}, {"expression": "droplevels(D[!duplicated(D$y), ])", "what_is_wrong": "deduplicates on y only, ignoring z", "counterexample": "D <- data.frame(x = factor(c(\"a\", \"b\")), y = c(1, 1), z = c(1, 2))"}, {"expression": "droplevels(D[duplicated(D[, c(\"y\", \"z\")]), ])", "what_is_wrong": "keeps the duplicates instead of removing them", "counterexample": "D <- data.frame(x = factor(c(\"a\", \"b\")), y = c(1, 1), z = c(1, 1))"}]}
{"item_id": "BM0023", "position": 23, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-004", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "anova(model_reduced, model_full, test = \"F\")", "what_is_wrong": "F test instead of Chi-squared LRT", "counterexample": "dat <- data.frame(ph_level = c(6, 6.5, 7, 7.5, 8, 6.2, 6.8, 7.3), treatment = factor(rep(c(\"a\", \"b\"), 4)), count = c(2, 3, 5, 4, 7, 1, 6, 3)); model_reduced <- glm(count ~ ph_level, family = poisson, data = dat); model_full <- glm(count ~ ph_level + treatment, family = poisson, data = dat)"}, {"expression": "anova(model_reduced, model_full, test = \"Rao\")", "what_is_wrong": "score test instead of likelihood-ratio Chi-squared", "counterexample": "dat <- data.frame(ph_level = c(6, 6.5, 7, 7.5, 8, 6.2, 6.8, 7.3), treatment = factor(rep(c(\"a\", \"b\"), 4)), count = c(2, 3, 5, 4, 7, 1, 6, 3)); model_reduced <- glm(count ~ ph_level, family = poisson, data = dat); model_full <- glm(count ~ ph_level + treatment, family = poisson, data = dat)"}, {"expression": "anova(model_full, test = \"Chisq\")", "what_is_wrong": "sequential analysis of deviance for one model, not the model comparison", "counterexample": "dat <- data.frame(ph_level = c(6, 6.5, 7, 7.5, 8, 6.2, 6.8, 7.3), treatment = factor(rep(c(\"a\", \"b\"), 4)), count = c(2, 3, 5, 4, 7, 1, 6, 3)); model_reduced <- glm(count ~ ph_level, family = poisson, data = dat); model_full <- glm(count ~ ph_level + treatment, family = poisson, data = dat)"}, {"expression": "summary(model_full)", "what_is_wrong": "Wald z tests, not a likelihood-ratio test", "counterexample": "dat <- data.frame(ph_level = c(6, 6.5, 7, 7.5, 8, 6.2, 6.8, 7.3), treatment = factor(rep(c(\"a\", \"b\"), 4)), count = c(2, 3, 5, 4, 7, 1, 6, 3)); model_reduced <- glm(count ~ ph_level, family = poisson, data = dat); model_full <- glm(count ~ ph_level + treatment, family = poisson, data = dat)"}]}
{"item_id": "BM0029", "position": 29, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-005", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sum(months(as.Date(d)) == \"January\")", "what_is_wrong": "ignores the Monday condition", "counterexample": "d <- c(\"2023-01-02\", \"2023-01-15\", \"2023-02-10\", \"2023-01-04\", \"2023-03-01\")"}, {"expression": "sum(weekdays(as.Date(d)) == \"Monday\" | months(as.Date(d)) == \"January\")", "what_is_wrong": "OR instead of AND", "counterexample": "d <- c(\"2023-01-02\", \"2023-01-15\", \"2023-02-10\", \"2023-01-04\", \"2023-03-01\")"}, {"expression": "sum(weekdays(as.Date(d)) == \"Mon\" & months(as.Date(d)) == \"January\")", "what_is_wrong": "abbreviated day name never matches weekdays() output", "counterexample": "d <- c(\"2023-01-02\", \"2023-01-15\", \"2023-02-10\", \"2023-01-04\", \"2023-03-01\")"}, {"expression": "length(weekdays(as.Date(d)) == \"Monday\" & months(as.Date(d)) == \"January\")", "what_is_wrong": "length instead of sum counts all elements", "counterexample": "d <- c(\"2023-01-02\", \"2023-01-15\", \"2023-02-10\", \"2023-01-04\", \"2023-03-01\")"}]}
{"item_id": "BM0034", "position": 34, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-006", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "tapply(defects, batch, sum)", "what_is_wrong": "sum instead of mean", "counterexample": "batch <- c(\"A\", \"A\", \"B\", \"B\", \"C\"); defects <- c(2, 5, 1, 3, 4)"}, {"expression": "tapply(batch, defects, mean)", "what_is_wrong": "arguments swapped", "counterexample": "batch <- c(\"A\", \"A\", \"B\", \"B\", \"C\"); defects <- c(2, 5, 1, 3, 4)"}, {"expression": "tapply(defects, batch, length)", "what_is_wrong": "counts per batch instead of mean", "counterexample": "batch <- c(\"A\", \"A\", \"B\", \"B\", \"C\"); defects <- c(2, 5, 1, 3, 4)"}, {"expression": "tapply(defects, batch, max)", "what_is_wrong": "max instead of mean", "counterexample": "batch <- c(\"A\", \"A\", \"B\", \"B\", \"C\"); defects <- c(2, 5, 1, 3, 4)"}]}
{"item_id": "BM0038", "position": 38, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-007", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "which((loglik[which.max(loglik)] - loglik) <= qchisq(0.95, 1))", "what_is_wrong": "missing factor of 2", "counterexample": "loglik <- c(0, -1, -2.5, -5)"}, {"expression": "which(2 * (loglik[which.max(loglik)] - loglik) <= qchisq(0.975, 1))", "what_is_wrong": "wrong quantile (0.975)", "counterexample": "loglik <- c(0, -1, -2.5, -5)"}, {"expression": "which(2 * (loglik[which.max(loglik)] - loglik) <= qnorm(0.975))", "what_is_wrong": "normal quantile instead of chi-squared quantile", "counterexample": "loglik <- c(0, -1, -2.5, -5)"}, {"expression": "which(2 * (loglik[which.max(loglik)] - loglik) >= qchisq(0.95, 1))", "what_is_wrong": "inequality reversed, returns points outside interval", "counterexample": "loglik <- c(0, -1, -2.5, -5)"}, {"expression": "which(2 * (loglik[which.max(loglik)] - loglik) <= qchisq(0.95, 2))", "what_is_wrong": "wrong degrees of freedom", "counterexample": "loglik <- c(0, -1, -2.5, -5)"}]}
{"item_id": "BM0043", "position": 43, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-008", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "rep(seq(3, 9, by = 3), times = 3)", "what_is_wrong": "times instead of each, wrong order", "counterexample": "invisible(NULL)"}, {"expression": "rep(3:9, each = 3)", "what_is_wrong": "uses all integers 3 to 9", "counterexample": "invisible(NULL)"}, {"expression": "seq(3, 9, by = 3)", "what_is_wrong": "no repetition", "counterexample": "invisible(NULL)"}, {"expression": "rep(seq(3, 9, length.out = 9), each = 3)", "what_is_wrong": "length.out instead of by gives wrong base values", "counterexample": "invisible(NULL)"}]}
{"item_id": "BM0049", "position": 49, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-009", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "quantile(rowMeans(matrix(rnorm(25*10000), 25)), c(0.025, 0.975))", "what_is_wrong": "row means give 25 means of 10000 values", "counterexample": "set.seed(123)"}, {"expression": "quantile(colMeans(matrix(rnorm(25*10000), 25)), c(0.05, 0.95))", "what_is_wrong": "wrong percentiles", "counterexample": "set.seed(123)"}, {"expression": "quantile(rnorm(10000), c(0.025, 0.975))", "what_is_wrong": "no sample means computed", "counterexample": "set.seed(123)"}, {"expression": "quantile(colSums(matrix(rnorm(25*10000), 25)), c(0.025, 0.975))", "what_is_wrong": "sums instead of means", "counterexample": "set.seed(123)"}]}
{"item_id": "BM0054", "position": 54, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-010", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "df[!is.na(df$x), ]", "what_is_wrong": "checks only column x", "counterexample": "df <- data.frame(x = c(1, NA, 3, 4, 5), y = c(10, 20, NA, 40, 50), z = c(100, 200, 300, NA, 500))"}, {"expression": "df[colSums(is.na(df)) == 0]", "what_is_wrong": "filters columns instead of rows", "counterexample": "df <- data.frame(x = c(1, NA, 3, 4, 5), y = c(10, 20, NA, 40, 50), z = c(100, 200, 300, NA, 500))"}, {"expression": "na.omit(df$x)", "what_is_wrong": "returns vector of one column", "counterexample": "df <- data.frame(x = c(1, NA, 3, 4, 5), y = c(10, 20, NA, 40, 50), z = c(100, 200, 300, NA, 500))"}, {"expression": "df[rowSums(is.na(df)) > 0, ]", "what_is_wrong": "keeps rows with missing values", "counterexample": "df <- data.frame(x = c(1, NA, 3, 4, 5), y = c(10, 20, NA, 40, 50), z = c(100, 200, 300, NA, 500))"}]}
{"item_id": "BM0058", "position": 58, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-011", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "names(which.min(var_estimates))", "what_is_wrong": "ignores the strictly positive condition", "counterexample": "var_estimates <- c(a = -1, b = 0, c = 2, d = 1)"}, {"expression": "names(var_estimates)[which.min(var_estimates[var_estimates > 0])]", "what_is_wrong": "index from subset applied to full name vector", "counterexample": "var_estimates <- c(a = -1, b = 0, c = 2, d = 1)"}, {"expression": "names(var_estimates[var_estimates >= 0])[which.min(var_estimates[var_estimates >= 0])]", "what_is_wrong": "includes zero, not strictly positive", "counterexample": "var_estimates <- c(a = -1, b = 0, c = 2, d = 1)"}, {"expression": "names(var_estimates[var_estimates > 0])[which.max(var_estimates[var_estimates > 0])]", "what_is_wrong": "which.max instead of which.min", "counterexample": "var_estimates <- c(a = -1, b = 0, c = 2, d = 1)"}]}
{"item_id": "BM0063", "position": 63, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-012", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "summary(fit)$coefficients", "what_is_wrong": "returns coefficient matrix, not named vector", "counterexample": "mydata <- data.frame(y = c(1, 3, 2, 5, 4), x = c(1, 2, 3, 4, 5), z = c(2, 1, 4, 3, 5)); fit <- lm(y ~ x + z, data = mydata)"}, {"expression": "coef(fit)[-1]", "what_is_wrong": "drops the intercept", "counterexample": "mydata <- data.frame(y = c(1, 3, 2, 5, 4), x = c(1, 2, 3, 4, 5), z = c(2, 1, 4, 3, 5)); fit <- lm(y ~ x + z, data = mydata)"}, {"expression": "fitted(fit)", "what_is_wrong": "fitted values instead of coefficients", "counterexample": "mydata <- data.frame(y = c(1, 3, 2, 5, 4), x = c(1, 2, 3, 4, 5), z = c(2, 1, 4, 3, 5)); fit <- lm(y ~ x + z, data = mydata)"}, {"expression": "confint(fit)", "what_is_wrong": "confidence intervals, not coefficients", "counterexample": "mydata <- data.frame(y = c(1, 3, 2, 5, 4), x = c(1, 2, 3, 4, 5), z = c(2, 1, 4, 3, 5)); fit <- lm(y ~ x + z, data = mydata)"}]}
{"item_id": "BM0069", "position": 69, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-013", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sales[sales$returned / sales$sold > 0.20 & sales$price > 100, ]", "what_is_wrong": "returns data frame rows instead of sku values", "counterexample": "sales <- data.frame(sku = c(\"A101\", \"B202\", \"C303\", \"D404\"), category = c(\"Electronics\", \"Clothing\", \"Electronics\", \"Home\"), price = c(299.99, 49.50, 120.00, 85.00), sold = c(150, 320, 90, 210), returned = c(45, 10, 35, 5))"}, {"expression": "sales$category[sales$returned / sales$sold > 0.20 & sales$price > 100]", "what_is_wrong": "extracts wrong column", "counterexample": "sales <- data.frame(sku = c(\"A101\", \"B202\", \"C303\", \"D404\"), category = c(\"Electronics\", \"Clothing\", \"Electronics\", \"Home\"), price = c(299.99, 49.50, 120.00, 85.00), sold = c(150, 320, 90, 210), returned = c(45, 10, 35, 5))"}, {"expression": "which(sales$returned / sales$sold > 0.20 & sales$price > 100)", "what_is_wrong": "returns row indices, not sku values", "counterexample": "sales <- data.frame(sku = c(\"A101\", \"B202\", \"C303\", \"D404\"), category = c(\"Electronics\", \"Clothing\", \"Electronics\", \"Home\"), price = c(299.99, 49.50, 120.00, 85.00), sold = c(150, 320, 90, 210), returned = c(45, 10, 35, 5))"}, {"expression": "sales$sku[sales$returned / sales$sold < 0.20 & sales$price > 100]", "what_is_wrong": "return-rate inequality reversed", "counterexample": "sales <- data.frame(sku = c(\"A101\", \"B202\", \"C303\", \"D404\"), category = c(\"Electronics\", \"Clothing\", \"Electronics\", \"Home\"), price = c(299.99, 49.50, 120.00, 85.00), sold = c(150, 320, 90, 210), returned = c(45, 10, 35, 5))"}]}
{"item_id": "BM0074", "position": 74, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-014", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "function(x) mean(x) + c(-1, 1) * 1.96 * sd(x) / sqrt(length(x))", "what_is_wrong": "z quantile instead of t quantile", "counterexample": "x <- c(1, 2, 4, 7)"}, {"expression": "function(x) mean(x) + c(-1, 1) * qt(0.975, length(x) - 1) * sd(x)", "what_is_wrong": "missing division by sqrt(n)", "counterexample": "x <- c(1, 2, 4, 7)"}, {"expression": "function(x) quantile(x, c(0.025, 0.975))", "what_is_wrong": "data percentiles, not CI for the mean", "counterexample": "x <- c(1, 2, 4, 7)"}, {"expression": "function(x) t.test(x, conf.level = 0.9)$conf.int", "what_is_wrong": "90% instead of 95% level", "counterexample": "x <- c(1, 2, 4, 7)"}]}
