{"item_id": "BM1190", "position": 118, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-023", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "backsolve(chol(H), forwardsolve(t(chol(H)), g))", "what_is_wrong": "sign of g wrong", "counterexample": "H <- matrix(c(4, 2, 2, 3), 2); g <- c(1, 2)"}, {"expression": "forwardsolve(t(chol(H)), backsolve(chol(H), -g))", "what_is_wrong": "triangular solves in wrong order", "counterexample": "H <- matrix(c(4, 2, 2, 3), 2); g <- c(1, 2)"}, {"expression": "backsolve(chol(H), -g)", "what_is_wrong": "only one triangular solve", "counterexample": "H <- matrix(c(4, 2, 2, 3), 2); g <- c(1, 2)"}, {"expression": "forwardsolve(t(chol(H)), -g)", "what_is_wrong": "missing back substitution step", "counterexample": "H <- matrix(c(4, 2, 2, 3), 2); g <- c(1, 2)"}]}
{"item_id": "BM0123", "position": 123, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-024", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "residuals(fit)", "what_is_wrong": "default deviance residuals", "counterexample": "age <- c(20, 30, 40, 50, 60); count <- c(2, 5, 7, 9, 12); fit <- glm(count ~ age, family = poisson)"}, {"expression": "residuals(fit, type = \"response\")", "what_is_wrong": "raw response residuals, not standardized by sqrt(mu)", "counterexample": "age <- c(20, 30, 40, 50, 60); count <- c(2, 5, 7, 9, 12); fit <- glm(count ~ age, family = poisson)"}, {"expression": "residuals(fit, type = \"working\")", "what_is_wrong": "working residuals", "counterexample": "age <- c(20, 30, 40, 50, 60); count <- c(2, 5, 7, 9, 12); fit <- glm(count ~ age, family = poisson)"}, {"expression": "(count - fitted(fit)) / fitted(fit)", "what_is_wrong": "divides by mu instead of sqrt(mu)", "counterexample": "age <- c(20, 30, 40, 50, 60); count <- c(2, 5, 7, 9, 12); fit <- glm(count ~ age, family = poisson)"}, {"expression": "rstandard(fit)", "what_is_wrong": "standardized deviance residuals", "counterexample": "age <- c(20, 30, 40, 50, 60); count <- c(2, 5, 7, 9, 12); fit <- glm(count ~ age, family = poisson)"}]}
