{"item_id": "BM0109", "position": 109, "batch": "2026-11-25_kc-variants_02", "anon_id": "V-02-021", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sapply(df, function(x) mean(x) / sd(x))", "what_is_wrong": "ratio inverted", "counterexample": "df <- data.frame(x = c(1, 2, 3, 4, 5), y = c(10, 20, 30, 40, 50), z = c(5, 4, 3, 2, 1))"}, {"expression": "sapply(df, function(x) var(x) / mean(x))", "what_is_wrong": "variance instead of sd", "counterexample": "df <- data.frame(x = c(1, 2, 3, 4, 5), y = c(10, 20, 30, 40, 50), z = c(5, 4, 3, 2, 1))"}, {"expression": "apply(df, 1, function(x) sd(x) / mean(x))", "what_is_wrong": "over rows instead of columns", "counterexample": "df <- data.frame(x = c(1, 2, 3, 4, 5), y = c(10, 20, 30, 40, 50), z = c(5, 4, 3, 2, 1))"}, {"expression": "sapply(df, function(x) sd(x) / sqrt(length(x)))", "what_is_wrong": "standard error instead of coefficient of variation", "counterexample": "df <- data.frame(x = c(1, 2, 3, 4, 5), y = c(10, 20, 30, 40, 50), z = c(5, 4, 3, 2, 1))"}]}
