{"item_id": "BM0509", "position": 509, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-024", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "apply(M, 2, function(x) max(x) - min(x))", "what_is_wrong": "works over columns instead of rows", "counterexample": "M <- matrix(c(1, 5, 2, 8, 3, 6, 4, 7, 9, 10, 11, 12), nrow = 3)"}, {"expression": "apply(M, 1, range)", "what_is_wrong": "returns a matrix of min and max, not their difference", "counterexample": "M <- matrix(c(1, 5, 2, 8, 3, 6, 4, 7, 9, 10, 11, 12), nrow = 3)"}, {"expression": "max(M) - min(M)", "what_is_wrong": "computes the overall range, not one per row", "counterexample": "M <- matrix(c(1, 5, 2, 8, 3, 6, 4, 7, 9, 10, 11, 12), nrow = 3)"}, {"expression": "apply(M, 1, function(x) x[length(x)] - x[1])", "what_is_wrong": "assumes the rows are sorted (last minus first)", "counterexample": "M <- matrix(c(1, 5, 2, 8, 3, 6, 4, 7, 9, 10, 11, 12), nrow = 3)"}, {"expression": "apply(M, 1, sd)", "what_is_wrong": "gives the standard deviation instead of the range", "counterexample": "M <- matrix(c(1, 5, 2, 8, 3, 6, 4, 7, 9, 10, 11, 12), nrow = 3)"}]}
