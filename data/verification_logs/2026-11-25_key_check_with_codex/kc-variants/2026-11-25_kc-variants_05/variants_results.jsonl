{"item_id": "BM0389", "position": 389, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-001", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "qnorm(0.2, mean = 180, sd = 15)", "what_is_wrong": "uses the lower 20% instead of 80%", "counterexample": "NULL"}, {"expression": "pnorm(0.8, mean = 180, sd = 15)", "what_is_wrong": "uses the CDF instead of the quantile function", "counterexample": "NULL"}, {"expression": "qnorm(0.8, mean = 180, sd = 225)", "what_is_wrong": "passes the variance as sd", "counterexample": "NULL"}, {"expression": "qnorm(0.8) * 15", "what_is_wrong": "leaves out the mean shift", "counterexample": "NULL"}]}
{"item_id": "BM1917", "position": 394, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-002", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "quantile(b_means, c(0.05, 0.95))", "what_is_wrong": "gives a 90% interval, not a 95% one", "counterexample": "b_means <- c(1, 2, 3, 4, 10, 6, 7, 8, 9, 5)"}, {"expression": "quantile(b_means, 0.975)", "what_is_wrong": "returns only the upper percentile", "counterexample": "b_means <- c(1, 2, 3, 4, 10)"}, {"expression": "mean(b_means) + c(-1.96, 1.96) * sd(b_means)", "what_is_wrong": "uses a normal interval instead of percentiles", "counterexample": "b_means <- c(1, 2, 3, 4, 10)"}, {"expression": "quantile(b_means, c(0.25, 0.75))", "what_is_wrong": "uses the quartiles instead of the 2.5th and 97.5th percentiles", "counterexample": "b_means <- c(1, 2, 3, 4, 10)"}]}
{"item_id": "BM1350", "position": 398, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-003", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "tapply(sal, dept, function(x) IQR(x) / sd(x))", "what_is_wrong": "leaves out na.rm, so HR becomes NA or an error", "counterexample": "dept <- c('HR', 'HR', 'HR', 'IT', 'IT', 'IT', 'MKT', 'MKT'); sal <- c(50, 60, NA, 80, 90, 100, 40, 50)"}, {"expression": "tapply(sal, dept, function(x) sd(x, na.rm = TRUE) / IQR(x, na.rm = TRUE))", "what_is_wrong": "inverts the ratio", "counterexample": "dept <- c('HR', 'HR', 'HR', 'IT', 'IT', 'IT', 'MKT', 'MKT'); sal <- c(50, 60, NA, 80, 90, 100, 40, 50)"}, {"expression": "tapply(sal, dept, function(x) IQR(x, na.rm = TRUE) / var(x, na.rm = TRUE))", "what_is_wrong": "divides by the variance instead of the sd", "counterexample": "dept <- c('HR', 'HR', 'HR', 'IT', 'IT', 'IT', 'MKT', 'MKT'); sal <- c(50, 60, NA, 80, 90, 100, 40, 50)"}, {"expression": "tapply(sal, dept, function(x) diff(range(x, na.rm = TRUE)) / sd(x, na.rm = TRUE))", "what_is_wrong": "uses the range instead of the IQR", "counterexample": "dept <- c('HR', 'HR', 'HR', 'IT', 'IT', 'IT', 'MKT', 'MKT'); sal <- c(50, 60, NA, 80, 90, 100, 40, 50)"}]}
{"item_id": "BM0403", "position": 403, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-004", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "paste(x, y)", "what_is_wrong": "the default sep inserts a space", "counterexample": "x <- c(\"ID\", \"ID\", \"ID\"); y <- 1:3"}, {"expression": "paste0(x, y, collapse = \"\")", "what_is_wrong": "collapses the result into a single string", "counterexample": "x <- c(\"ID\", \"ID\", \"ID\"); y <- 1:3"}, {"expression": "paste(x, y, sep = \"_\")", "what_is_wrong": "uses the wrong separator", "counterexample": "x <- c(\"ID\", \"ID\", \"ID\"); y <- 1:3"}, {"expression": "paste0(y, x)", "what_is_wrong": "puts the arguments in the wrong order", "counterexample": "x <- c(\"ID\", \"ID\", \"ID\"); y <- 1:3"}]}
{"item_id": "BM0409", "position": 409, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-005", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "do.call(cbind, parts)", "what_is_wrong": "combines column-wise instead of row-wise", "counterexample": "parts <- list(data.frame(a = 1, b = 2), data.frame(a = 3, b = 4), data.frame(a = 5, b = 6))"}, {"expression": "rbind(parts)", "what_is_wrong": "binds the list itself instead of its elements", "counterexample": "parts <- list(data.frame(a = 1, b = 2), data.frame(a = 3, b = 4), data.frame(a = 5, b = 6))"}, {"expression": "do.call(c, parts)", "what_is_wrong": "concatenates into a list of columns, not a data frame", "counterexample": "parts <- list(data.frame(a = 1, b = 2), data.frame(a = 3, b = 4), data.frame(a = 5, b = 6))"}, {"expression": "do.call(rbind, parts[-1])", "what_is_wrong": "drops the first data frame", "counterexample": "parts <- list(data.frame(a = 1, b = 2), data.frame(a = 3, b = 4), data.frame(a = 5, b = 6))"}]}
{"item_id": "BM0414", "position": 414, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-006", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "M[M >= 6]", "what_is_wrong": "uses >= instead of strict >", "counterexample": "M <- matrix(1:12, nrow = 3)"}, {"expression": "M > 6", "what_is_wrong": "returns a logical matrix, not the elements", "counterexample": "M <- matrix(1:12, nrow = 3)"}, {"expression": "sum(M > 6)", "what_is_wrong": "counts the elements instead of returning them", "counterexample": "M <- matrix(1:12, nrow = 3)"}, {"expression": "M[M > 7]", "what_is_wrong": "uses the wrong threshold", "counterexample": "M <- matrix(1:12, nrow = 3)"}]}
{"item_id": "BM0418", "position": 418, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-007", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "data.frame(x, y, grp, row.names = x, check.names = FALSE)", "what_is_wrong": "grp stays character, not a factor", "counterexample": "x <- c(1, 2, 3); y <- c(4, 5, 6); grp <- c(\"B\", \"A\", \"C\")"}, {"expression": "data.frame(x, y, grp = factor(grp, levels = unique(grp)), row.names = x, check.names = FALSE)", "what_is_wrong": "levels follow order of appearance (B, A, C)", "counterexample": "x <- c(1, 2, 3); y <- c(4, 5, 6); grp <- c(\"B\", \"A\", \"C\")"}, {"expression": "data.frame(x, y, grp = factor(grp, levels = c(\"A\", \"B\", \"C\")), row.names = y, check.names = FALSE)", "what_is_wrong": "sets the row names from y instead of x", "counterexample": "x <- c(1, 2, 3); y <- c(4, 5, 6); grp <- c(\"B\", \"A\", \"C\")"}, {"expression": "data.frame(x, y, grp = factor(grp, levels = c(\"A\", \"B\", \"C\"), ordered = TRUE), row.names = x, check.names = FALSE)", "what_is_wrong": "creates an ordered factor instead of a plain factor", "counterexample": "x <- c(1, 2, 3); y <- c(4, 5, 6); grp <- c(\"B\", \"A\", \"C\")"}]}
{"item_id": "BM0423", "position": 423, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-008", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "pnorm(0.5, lower.tail = FALSE)", "what_is_wrong": "gives the upper-tail probability", "counterexample": "NULL"}, {"expression": "dnorm(0.5)", "what_is_wrong": "gives the density, not the cumulative probability", "counterexample": "NULL"}, {"expression": "qnorm(0.5)", "what_is_wrong": "uses the quantile function", "counterexample": "NULL"}, {"expression": "pnorm(0.5, sd = 0.5)", "what_is_wrong": "not the standard normal", "counterexample": "NULL"}]}
{"item_id": "BM0429", "position": 429, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-009", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "x[order(sub('.*_', '', x))]", "what_is_wrong": "sorts the suffixes as character, not numerically", "counterexample": "x <- c('val_3', 'val_10', 'val_2', 'val_20')"}, {"expression": "sort(x)", "what_is_wrong": "sorts the whole strings lexicographically", "counterexample": "x <- c('val_3', 'val_10', 'val_2', 'val_20')"}, {"expression": "order(as.numeric(sub('.*_', '', x)))", "what_is_wrong": "returns indices instead of elements", "counterexample": "x <- c('val_3', 'val_10', 'val_2', 'val_20')"}, {"expression": "x[sort(as.numeric(sub('.*_', '', x)))]", "what_is_wrong": "indexes by the sorted values instead of using order", "counterexample": "x <- c('val_3', 'val_10', 'val_2', 'val_20')"}]}
{"item_id": "BM0434", "position": 434, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-010", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "outer(amps, volts)", "what_is_wrong": "rows and columns are swapped", "counterexample": "volts <- c(2, 4); amps <- c(10, 20, 50)"}, {"expression": "volts * amps", "what_is_wrong": "elementwise recycling, not an outer product", "counterexample": "volts <- c(2, 4); amps <- c(10, 20, 50)"}, {"expression": "outer(volts, amps, \"+\")", "what_is_wrong": "adds instead of multiplying", "counterexample": "volts <- c(2, 4); amps <- c(10, 20, 50)"}, {"expression": "outer(volts, amps, \"/\")", "what_is_wrong": "divides instead of multiplying", "counterexample": "volts <- c(2, 4); amps <- c(10, 20, 50)"}]}
{"item_id": "BM0438", "position": 438, "batch": "2026-11-25_kc-variants_05", "anon_id": "V-05-011", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "d[seq(k, length(d), by = k)]", "what_is_wrong": "starts at the k-th element instead of the first", "counterexample": "d <- c(1, 2, 3, 4, 5, 6, 7); k <- 2"}, {"expression": "d[seq(1, length(d), length.out = k)]", "what_is_wrong": "uses length.out instead of the step size", "counterexample": "d <- c(1, 2, 3, 4, 5, 6, 7); k <- 2"}, {"expression": "d[1:(length(d) %/% k)]", "what_is_wrong": "takes the first n/k elements instead of every k-th", "counterexample": "d <- c(1, 2, 3, 4, 5, 6, 7); k <- 2"}, {"expression": "d[seq(1, length(d) %/% k * k, by = k)]", "what_is_wrong": "truncates the range and drops the last valid index", "counterexample": "d <- c(1, 2, 3, 4, 5, 6, 7); k <- 2"}, {"expression": "d[seq(1, length(d), by = k + 1)]", "what_is_wrong": "off-by-one step size", "counterexample": "d <- c(1, 2, 3, 4, 5, 6, 7); k <- 2"}]}
