{"item_id": "BM0263", "position": 263, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-001", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "do.call(rbind, L)", "what_is_wrong": "rbind gives a 3x3 matrix with vectors as rows, not a data frame", "counterexample": "L <- list(a = 1:3, b = 4:6, c = 7:9)"}, {"expression": "do.call(cbind, L)", "what_is_wrong": "returns a matrix, not a data frame", "counterexample": "L <- list(a = 1:3, b = 4:6, c = 7:9)"}, {"expression": "do.call(rbind.data.frame, L)", "what_is_wrong": "stacks the vectors as rows, so the result is transposed", "counterexample": "L <- list(a = 1:3, b = 4:6, c = 7:9)"}, {"expression": "do.call(list, L)", "what_is_wrong": "returns a list, not a data frame", "counterexample": "L <- list(a = 1:3, b = 4:6, c = 7:9)"}]}
{"item_id": "BM0269", "position": 269, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-002", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "merge(a, b, by = \"id\")", "what_is_wrong": "inner join drops unmatched rows of a", "counterexample": "a <- data.frame(id = 1:3, x = c(10, 20, 30)); b <- data.frame(id = c(2, 3, 4), y = c(100, 200, 300))"}, {"expression": "merge(a, b, by = \"id\", all = TRUE)", "what_is_wrong": "full join also adds rows of b that have no match", "counterexample": "a <- data.frame(id = 1:3, x = c(10, 20, 30)); b <- data.frame(id = c(2, 3, 4), y = c(100, 200, 300))"}, {"expression": "merge(a, b, by = \"id\", all.y = TRUE)", "what_is_wrong": "keeps all rows of b instead of a", "counterexample": "a <- data.frame(id = 1:3, x = c(10, 20, 30)); b <- data.frame(id = c(2, 3, 4), y = c(100, 200, 300))"}, {"expression": "merge(b, a, by = \"id\", all.x = TRUE)", "what_is_wrong": "swaps the arguments, so the left join keeps the rows of b", "counterexample": "a <- data.frame(id = 1:3, x = c(10, 20, 30)); b <- data.frame(id = c(2, 3, 4), y = c(100, 200, 300))"}]}
{"item_id": "BM0274", "position": 274, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-003", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "function(x) list(m = mean(x), s = var(x))", "what_is_wrong": "variance instead of standard deviation", "counterexample": "x <- c(1, 2, 6)"}, {"expression": "function(x) c(m = mean(x), s = sd(x))", "what_is_wrong": "returns a named vector, not a list", "counterexample": "x <- c(1, 2, 6)"}, {"expression": "function(x) list(mean(x), sd(x))", "what_is_wrong": "list elements are not named", "counterexample": "x <- c(1, 2, 6)"}, {"expression": "function(x) list(m = mean(x), s = sqrt(mean((x - mean(x))^2)))", "what_is_wrong": "divides by n instead of n - 1", "counterexample": "x <- c(1, 2, 6)"}]}
{"item_id": "BM1699", "position": 278, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-004", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "qnorm(0.9, 12, 4)", "what_is_wrong": "ignores the condition that the call takes longer than 8 minutes", "counterexample": "invisible(NULL)"}, {"expression": "qnorm(0.9 * (1 - pnorm(8, 12, 4)), 12, 4)", "what_is_wrong": "leaves out the probability below 8 when converting to the unconditional scale", "counterexample": "invisible(NULL)"}, {"expression": "qnorm(0.1 + 0.9 * pnorm(8, 12, 4), 12, 4)", "what_is_wrong": "swaps 0.9 and 0.1", "counterexample": "invisible(NULL)"}, {"expression": "qnorm(0.9 + 0.1 * pnorm(8, 12, 4), 12, 16)", "what_is_wrong": "passes the variance as the sd", "counterexample": "invisible(NULL)"}, {"expression": "qnorm(0.9 * pnorm(8, 12, 4, lower.tail = FALSE), 12, 4, lower.tail = FALSE)", "what_is_wrong": "returns the 10th percentile of the delayed calls, not the 90th", "counterexample": "invisible(NULL)"}]}
{"item_id": "BM0283", "position": 283, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-005", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sum(v) / (length(v) - 1)", "what_is_wrong": "uses n - 1 as the denominator", "counterexample": "v <- c(4, 8, 12, 16, 20)"}, {"expression": "sum(v)", "what_is_wrong": "sum instead of mean", "counterexample": "v <- c(4, 8, 12, 16, 20)"}, {"expression": "mean(v[-1])", "what_is_wrong": "drops the first element", "counterexample": "v <- c(4, 8, 12, 16, 20)"}, {"expression": "mean(v^2)", "what_is_wrong": "averages the squares", "counterexample": "v <- c(4, 8, 12, 16, 20)"}]}
{"item_id": "BM0289", "position": 289, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-006", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "mean(exam_scores)", "what_is_wrong": "no na.rm, so the result is NA", "counterexample": "exam_scores <- c(70, NA, 90)"}, {"expression": "sum(exam_scores, na.rm = TRUE) / length(exam_scores)", "what_is_wrong": "the denominator still counts the NA entries", "counterexample": "exam_scores <- c(70, NA, 90)"}, {"expression": "median(exam_scores, na.rm = TRUE)", "what_is_wrong": "median instead of mean", "counterexample": "exam_scores <- c(70, NA, 80, 120)"}, {"expression": "mean(exam_scores[!is.na(exam_scores)][-1])", "what_is_wrong": "also drops the first valid score", "counterexample": "exam_scores <- c(70, NA, 90)"}]}
{"item_id": "BM0294", "position": 294, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-007", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "mean(rnorm(200, 3, 4))", "what_is_wrong": "passes the variance as the sd", "counterexample": "set.seed(1)"}, {"expression": "mean(rnorm(200, 2, 3))", "what_is_wrong": "mean and sd swapped", "counterexample": "set.seed(1)"}, {"expression": "sd(rnorm(200, 3, 2))", "what_is_wrong": "computes the sd instead of the mean", "counterexample": "set.seed(1)"}, {"expression": "mean(rnorm(20, 3, 2))", "what_is_wrong": "wrong number of observations", "counterexample": "set.seed(1)"}]}
{"item_id": "BM1898", "position": 298, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-008", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "mean(abs(outer(1:10, 1:10, `-`)))", "what_is_wrong": "absolute distance instead of squared distance", "counterexample": "invisible(NULL)"}, {"expression": "2 * var(1:10)", "what_is_wrong": "uses the n - 1 sample variance instead of the population variance", "counterexample": "invisible(NULL)"}, {"expression": "sum((outer(1:10, 1:10, `-`))^2) / 10", "what_is_wrong": "divides by 10 instead of 100", "counterexample": "invisible(NULL)"}, {"expression": "mean(outer(1:10, 1:10, `-`))^2", "what_is_wrong": "squares the mean instead of averaging the squares", "counterexample": "invisible(NULL)"}]}
{"item_id": "BM0303", "position": 303, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-009", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "regmatches(x, regexpr(\"[0-9]\", x))", "what_is_wrong": "no +, so only the first digit is matched", "counterexample": "x <- \"ID_99_test\""}, {"expression": "regexpr(\"[0-9]+\", x)", "what_is_wrong": "returns the match position, not the substring", "counterexample": "x <- \"ID_99_test\""}, {"expression": "regmatches(x, regexpr(\"[a-z]+\", x))", "what_is_wrong": "wrong character class, matches letters", "counterexample": "x <- \"ID_99_test\""}, {"expression": "regmatches(x, regexpr(\"_[0-9]+\", x))", "what_is_wrong": "includes the underscore in the match", "counterexample": "x <- \"ID_99_test\""}]}
{"item_id": "BM0309", "position": 309, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-010", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "lapply(L, function(x) median(x) - x)", "what_is_wrong": "subtraction reversed, so the sign is wrong", "counterexample": "L <- list(c(1, 2, 3), c(4, 5, 6), c(10, 11, 12, 13))"}, {"expression": "lapply(L, function(x) x - median(unlist(L)))", "what_is_wrong": "uses the overall median instead of each vector's own median", "counterexample": "L <- list(c(1, 2, 3), c(4, 5, 6), c(10, 11, 12, 13))"}, {"expression": "lapply(L, function(x) x - x[2])", "what_is_wrong": "uses the second element, which is not the median for even-length vectors", "counterexample": "L <- list(c(1, 2, 3), c(4, 5, 6), c(10, 11, 12, 13))"}, {"expression": "lapply(L, median)", "what_is_wrong": "returns the medians, not the centered vectors", "counterexample": "L <- list(c(1, 2, 3), c(4, 5, 6), c(10, 11, 12, 13))"}]}
{"item_id": "BM0314", "position": 314, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-011", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "matrix(50:61, nrow = 3)", "what_is_wrong": "fills by column", "counterexample": "invisible(NULL)"}, {"expression": "matrix(50:61, nrow = 4, byrow = TRUE)", "what_is_wrong": "wrong dimensions (4 by 3)", "counterexample": "invisible(NULL)"}, {"expression": "matrix(51:62, nrow = 3, byrow = TRUE)", "what_is_wrong": "off-by-one range", "counterexample": "invisible(NULL)"}, {"expression": "t(matrix(50:61, nrow = 3))", "what_is_wrong": "transposes a column-filled matrix, giving 4 by 3", "counterexample": "invisible(NULL)"}]}
{"item_id": "BM0318", "position": 318, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-012", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sum(diag(V * t(V)))", "what_is_wrong": "elementwise product instead of matrix product", "counterexample": "V <- matrix(c(2,1,0,1,3,1,0,1,2), nrow = 3, byrow = TRUE)"}, {"expression": "sum(diag(V))^2", "what_is_wrong": "squares the trace", "counterexample": "V <- matrix(c(2,1,0,1,3,1,0,1,2), nrow = 3, byrow = TRUE)"}, {"expression": "sum(V %*% t(V))", "what_is_wrong": "sums every element instead of only the diagonal", "counterexample": "V <- matrix(c(2,1,0,1,3,1,0,1,2), nrow = 3, byrow = TRUE)"}, {"expression": "diag(V %*% t(V))", "what_is_wrong": "returns the diagonal without summing it", "counterexample": "V <- matrix(c(2,1,0,1,3,1,0,1,2), nrow = 3, byrow = TRUE)"}]}
{"item_id": "BM0323", "position": 323, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-013", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "residuals(fit)", "what_is_wrong": "residuals instead of fitted values", "counterexample": "rent <- c(1, 3, 2, 5); size <- 1:4; fit <- lm(rent ~ size)"}, {"expression": "coef(fit)", "what_is_wrong": "returns the coefficients", "counterexample": "rent <- c(1, 3, 2, 5); size <- 1:4; fit <- lm(rent ~ size)"}, {"expression": "fit$model$rent", "what_is_wrong": "returns the observed responses", "counterexample": "rent <- c(1, 3, 2, 5); size <- 1:4; fit <- lm(rent ~ size)"}, {"expression": "coef(fit)[2] * size", "what_is_wrong": "leaves out the intercept", "counterexample": "rent <- c(1, 3, 2, 5); size <- 1:4; fit <- lm(rent ~ size)"}]}
{"item_id": "BM1307", "position": 329, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-014", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "round(0.15 * salaries / 25) * 25", "what_is_wrong": "rounds instead of truncating", "counterexample": "salaries <- c(45230, 67875, 52399, 88941)"}, {"expression": "trunc(0.15 * salaries)", "what_is_wrong": "truncates to whole dollars, not to multiples of 25", "counterexample": "salaries <- c(45230, 67875, 52399, 88941)"}, {"expression": "trunc(0.15 * salaries / 25)", "what_is_wrong": "does not multiply back by 25", "counterexample": "salaries <- c(45230, 67875, 52399, 88941)"}, {"expression": "ceiling(0.15 * salaries / 25) * 25", "what_is_wrong": "rounds up", "counterexample": "salaries <- c(45230, 67875, 52399, 88941)"}, {"expression": "trunc(salaries / 25) * 25 * 0.15", "what_is_wrong": "truncates the salary before applying the 15 percent", "counterexample": "salaries <- c(45230, 67875, 52399, 88941)"}]}
{"item_id": "BM0334", "position": 334, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-015", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sapply(df, mean)", "what_is_wrong": "mean instead of sum", "counterexample": "df <- data.frame(a = 1:4, b = 10:13)"}, {"expression": "sapply(df, length)", "what_is_wrong": "counts elements instead of summing them", "counterexample": "df <- data.frame(a = 1:4, b = 10:13)"}, {"expression": "sum(sapply(df, sum))", "what_is_wrong": "returns the grand total instead of per-column sums", "counterexample": "df <- data.frame(a = 1:4, b = 10:13)"}, {"expression": "sapply(df, cumsum)", "what_is_wrong": "cumulative sums instead of totals", "counterexample": "df <- data.frame(a = 1:4, b = 10:13)"}]}
{"item_id": "BM1317", "position": 338, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-016", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "sum(lengths(strsplit(x, \"|\", fixed = TRUE)))", "what_is_wrong": "counts the empty strings too", "counterexample": "x <- c('1.2|3.4|5.6', '7.8||9.0', '10.1|')"}, {"expression": "sum(lengths(lapply(strsplit(x, \"|\"), function(v) v[v != \"\"])))", "what_is_wrong": "without fixed, the regex | matches the empty string and splits into single characters", "counterexample": "x <- c('1.2|3.4|5.6', '7.8||9.0', '10.1|')"}, {"expression": "length(strsplit(x, \"|\", fixed = TRUE))", "what_is_wrong": "counts list elements, not the pieces", "counterexample": "x <- c('1.2|3.4|5.6', '7.8||9.0', '10.1|')"}, {"expression": "lengths(lapply(strsplit(x, \"|\", fixed = TRUE), function(v) v[v != \"\"]))", "what_is_wrong": "returns per-element counts, not the total", "counterexample": "x <- c('1.2|3.4|5.6', '7.8||9.0', '10.1|')"}]}
{"item_id": "BM0343", "position": 343, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-017", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "cumprod(x)", "what_is_wrong": "cumulative product", "counterexample": "x <- c(4, 1, 6, 3)"}, {"expression": "sum(x)", "what_is_wrong": "returns only the total", "counterexample": "x <- c(4, 1, 6, 3)"}, {"expression": "cumsum(sort(x))", "what_is_wrong": "sorts the vector first", "counterexample": "x <- c(4, 1, 6, 3)"}, {"expression": "rev(cumsum(rev(x)))", "what_is_wrong": "accumulates from the end", "counterexample": "x <- c(4, 1, 6, 3)"}]}
{"item_id": "BM0349", "position": 349, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-018", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "anxiety %*% t(depression)", "what_is_wrong": "outer product instead of inner product", "counterexample": "anxiety <- c(0.5, -1.2, 0.8, -0.3, 1.1); depression <- c(0.6, -0.9, 0.7, -0.4, 1.0)"}, {"expression": "t(anxiety) * depression", "what_is_wrong": "elementwise product, not summed", "counterexample": "anxiety <- c(0.5, -1.2, 0.8, -0.3, 1.1); depression <- c(0.6, -0.9, 0.7, -0.4, 1.0)"}, {"expression": "t(anxiety) %*% anxiety", "what_is_wrong": "uses the wrong second vector", "counterexample": "anxiety <- c(0.5, -1.2, 0.8, -0.3, 1.1); depression <- c(0.6, -0.9, 0.7, -0.4, 1.0)"}, {"expression": "anxiety %o% depression", "what_is_wrong": "outer product", "counterexample": "anxiety <- c(0.5, -1.2, 0.8, -0.3, 1.1); depression <- c(0.6, -0.9, 0.7, -0.4, 1.0)"}]}
{"item_id": "BM0354", "position": 354, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-019", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "readings[readings >= 19.5 & readings <= 21.0]", "what_is_wrong": "uses non-strict inequalities", "counterexample": "readings <- c(22.1, 19.8, 20.5, 21.3, 18.9, 20.2, 23.1, 19.5)"}, {"expression": "readings[readings > 19.5 | readings < 21.0]", "what_is_wrong": "OR instead of AND", "counterexample": "readings <- c(22.1, 19.8, 20.5, 21.3, 18.9, 20.2, 23.1, 19.5)"}, {"expression": "which(readings > 19.5 & readings < 21.0)", "what_is_wrong": "returns indices, not values", "counterexample": "readings <- c(22.1, 19.8, 20.5, 21.3, 18.9, 20.2, 23.1, 19.5)"}, {"expression": "readings > 19.5 & readings < 21.0", "what_is_wrong": "returns a logical vector", "counterexample": "readings <- c(22.1, 19.8, 20.5, 21.3, 18.9, 20.2, 23.1, 19.5)"}]}
{"item_id": "BM0358", "position": 358, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-020", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "rowMeans(outer(x, x, \"<=\"))", "what_is_wrong": "wrong margin; gives the proportion of values >= each value", "counterexample": "x <- c(1, 3, 2, 3, 1)"}, {"expression": "colMeans(outer(x, x, \"<\"))", "what_is_wrong": "strict inequality, so ties are excluded", "counterexample": "x <- c(1, 3, 2, 3, 1)"}, {"expression": "colSums(outer(x, x, \"<=\"))", "what_is_wrong": "counts instead of proportions", "counterexample": "x <- c(1, 3, 2, 3, 1)"}, {"expression": "seq_along(x) / length(x)", "what_is_wrong": "ignores the data values and ties", "counterexample": "x <- c(1, 3, 2, 3, 1)"}]}
{"item_id": "BM0363", "position": 363, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-021", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "x[2]", "what_is_wrong": "single bracket returns a sub-list, not the vector", "counterexample": "x <- list(first = 5, second = c(10, 20, 30), third = 'data')"}, {"expression": "x[\"second\"]", "what_is_wrong": "returns a list", "counterexample": "x <- list(first = 5, second = c(10, 20, 30), third = 'data')"}, {"expression": "x[[3]]", "what_is_wrong": "wrong element", "counterexample": "x <- list(first = 5, second = c(10, 20, 30), third = 'data')"}, {"expression": "x$second[1]", "what_is_wrong": "returns only the first value", "counterexample": "x <- list(first = 5, second = c(10, 20, 30), third = 'data')"}]}
{"item_id": "BM0369", "position": 369, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-022", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "function(observed, baseline) (observed - baseline) / baseline * 100", "what_is_wrong": "no default value for baseline", "counterexample": "observed <- 0.6"}, {"expression": "function(observed, baseline = 0.50) (observed - baseline) / observed * 100", "what_is_wrong": "divides by observed instead of baseline", "counterexample": "observed <- 0.6"}, {"expression": "function(observed, baseline = 0.50) observed - baseline / baseline * 100", "what_is_wrong": "missing parentheses, so operator precedence is wrong", "counterexample": "observed <- 0.6"}, {"expression": "function(observed, baseline = 0.05) (observed - baseline) / baseline * 100", "what_is_wrong": "wrong default (0.05)", "counterexample": "observed <- 0.6"}, {"expression": "function(observed, baseline = 0.50) (observed - baseline) / baseline", "what_is_wrong": "does not multiply by 100", "counterexample": "observed <- 0.6"}]}
{"item_id": "BM0374", "position": 374, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-023", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "fact <- function(n) if (n <= 1) 0 else n * fact(n - 1)", "what_is_wrong": "base case returns 0", "counterexample": "n <- 5"}, {"expression": "fact <- function(n) if (n <= 1) 1 else n + fact(n - 1)", "what_is_wrong": "addition instead of multiplication", "counterexample": "n <- 5"}, {"expression": "fact <- function(n) if (n <= 1) n else n * fact(n - 1)", "what_is_wrong": "returns 0 for n = 0", "counterexample": "n <- 0"}, {"expression": "fact <- function(n) if (n <= 1) 1 else (n - 1) * fact(n - 1)", "what_is_wrong": "off-by-one multiplier", "counterexample": "n <- 5"}]}
{"item_id": "BM0378", "position": 378, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-024", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "An lm object has no 'sigma' component, so mod$sigma is NULL and the key returns only r2. It should use summary(mod)$sigma or sigma(mod).", "variants": [{"expression": "function(mod) c(r2 = summary(mod)$adj.r.squared, sigma = summary(mod)$sigma)", "what_is_wrong": "adjusted R-squared instead of multiple R-squared", "counterexample": "mod <- lm(dist ~ speed, data = cars)"}, {"expression": "function(mod) c(r2 = summary(mod)$r.squared, sigma = summary(mod)$sigma^2)", "what_is_wrong": "residual variance instead of the residual standard error", "counterexample": "mod <- lm(dist ~ speed, data = cars)"}, {"expression": "function(mod) c(r2 = summary(mod)$r.squared, sigma = sqrt(mean(residuals(mod)^2)))", "what_is_wrong": "divides by n instead of the residual degrees of freedom", "counterexample": "mod <- lm(dist ~ speed, data = cars)"}, {"expression": "function(mod) c(r2 = summary(mod)$r.squared, sigma = sd(residuals(mod)))", "what_is_wrong": "uses n - 1 instead of n - p as the denominator", "counterexample": "mod <- lm(dist ~ speed, data = cars)"}]}
{"item_id": "BM1339", "position": 383, "batch": "2026-11-25_kc-variants_04", "anon_id": "V-04-025", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "quantile(mtcars$hp, 0.25)", "what_is_wrong": "wrong probability", "counterexample": "invisible(NULL)"}, {"expression": "median(mtcars$hp)", "what_is_wrong": "computes the 0.5 quantile", "counterexample": "invisible(NULL)"}, {"expression": "quantile(mtcars$mpg, 0.75)", "what_is_wrong": "wrong column", "counterexample": "invisible(NULL)"}, {"expression": "quantile(mtcars$hp)", "what_is_wrong": "returns all quartiles", "counterexample": "invisible(NULL)"}]}
