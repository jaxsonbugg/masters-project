{"variants": [{"id": "V-09-001", "key_concern": "", "variants": [{"expression": "tapply(x, g, mean)", "what_is_wrong": "mean instead of sum", "counterexample": "x <- c(10, 20, 30, 40, 50, 60); g <- factor(c(\"A\", \"A\", \"B\", \"B\", \"A\", \"B\"))"}, {"expression": "tapply(x, g, length)", "what_is_wrong": "counts per group instead of sums", "counterexample": "x <- c(10, 20, 30, 40, 50, 60); g <- factor(c(\"A\", \"A\", \"B\", \"B\", \"A\", \"B\"))"}, {"expression": "tapply(g, x, sum)", "what_is_wrong": "arguments swapped", "counterexample": "x <- c(10, 20, 30, 40, 50, 60); g <- factor(c(\"A\", \"A\", \"B\", \"B\", \"A\", \"B\"))"}, {"expression": "sum(x)", "what_is_wrong": "overall sum, ignores groups", "counterexample": "x <- c(10, 20, 30, 40, 50, 60); g <- factor(c(\"A\", \"A\", \"B\", \"B\", \"A\", \"B\"))"}, {"expression": "tapply(x, g, cumsum)", "what_is_wrong": "cumulative sums instead of totals", "counterexample": "x <- c(10, 20, 30, 40, 50, 60); g <- factor(c(\"A\", \"A\", \"B\", \"B\", \"A\", \"B\"))"}]}, {"id": "V-09-002", "key_concern": "", "variants": [{"expression": "M %*% x", "what_is_wrong": "no transpose (non-conformable)", "counterexample": "M <- matrix(1:6, nrow = 3); x <- c(1, 2, 3)"}, {"expression": "t(M) * x", "what_is_wrong": "elementwise product, not matrix product", "counterexample": "M <- matrix(1:6, nrow = 3); x <- c(1, 2, 3)"}, {"expression": "t(x) %*% M", "what_is_wrong": "gives a 1x2 row instead of a 2x1 column", "counterexample": "M <- matrix(1:6, nrow = 3); x <- c(1, 2, 3)"}, {"expression": "t(M %*% x)", "what_is_wrong": "transposes the product instead of M", "counterexample": "M <- matrix(1:6, nrow = 3); x <- c(1, 2, 3)"}, {"expression": "crossprod(x, M)", "what_is_wrong": "gives x'M (a row) instead of M'x", "counterexample": "M <- matrix(1:6, nrow = 3); x <- c(1, 2, 3)"}]}, {"id": "V-09-003", "key_concern": "The key returns elements BELOW the diagonal: upper.tri(t(M)) picks t(M)[i,j] with i<j, which is M[j,i]. The correct expression is t(M)[lower.tri(t(M))].", "variants": [{"expression": "M[upper.tri(M)]", "what_is_wrong": "column-major order, not row-major", "counterexample": "M <- matrix(c(5, 2, 9, 1, 7, 3, 8, 6, 4, 11, 13, 10, 12, 15, 14, 16), nrow = 4)"}, {"expression": "M[lower.tri(M)]", "what_is_wrong": "elements below the diagonal, column-major", "counterexample": "M <- matrix(c(5, 2, 9, 1, 7, 3, 8, 6, 4, 11, 13, 10, 12, 15, 14, 16), nrow = 4)"}, {"expression": "t(M)[upper.tri(t(M), diag = TRUE)]", "what_is_wrong": "includes the diagonal", "counterexample": "M <- matrix(c(5, 2, 9, 1, 7, 3, 8, 6, 4, 11, 13, 10, 12, 15, 14, 16), nrow = 4)"}, {"expression": "M[row(M) <= col(M)]", "what_is_wrong": "includes the diagonal and uses column-major order", "counterexample": "M <- matrix(c(5, 2, 9, 1, 7, 3, 8, 6, 4, 11, 13, 10, 12, 15, 14, 16), nrow = 4)"}]}, {"id": "V-09-004", "key_concern": "", "variants": [{"expression": "arima(x, order = c(0, 0, 1))", "what_is_wrong": "MA(1) instead of AR(1)", "counterexample": "x <- c(12, 15, 14, 16, 13, 15, 14, 17, 16, 15)"}, {"expression": "arima(x, order = c(1, 1, 0))", "what_is_wrong": "applies first differencing", "counterexample": "x <- c(12, 15, 14, 16, 13, 15, 14, 17, 16, 15)"}, {"expression": "arima(x, order = c(1, 0, 0), include.mean = FALSE)", "what_is_wrong": "drops the mean term", "counterexample": "x <- c(12, 15, 14, 16, 13, 15, 14, 17, 16, 15)"}, {"expression": "arima(x, order = c(0, 1, 0))", "what_is_wrong": "random walk; orders misplaced", "counterexample": "x <- c(12, 15, 14, 16, 13, 15, 14, 17, 16, 15)"}]}, {"id": "V-09-005", "key_concern": "", "variants": [{"expression": "unique(mtcars[, c(\"cyl\", \"am\")])", "what_is_wrong": "keeps only the two key columns", "counterexample": "mtcars <- datasets::mtcars"}, {"expression": "mtcars[duplicated(mtcars[, c(\"cyl\", \"am\")]), ]", "what_is_wrong": "keeps the duplicates instead of the first occurrences", "counterexample": "mtcars <- datasets::mtcars"}, {"expression": "mtcars[!duplicated(mtcars$cyl), ]", "what_is_wrong": "checks only cyl, not cyl and am", "counterexample": "mtcars <- datasets::mtcars"}, {"expression": "mtcars[!duplicated(mtcars[, c(\"cyl\", \"am\")], fromLast = TRUE), ]", "what_is_wrong": "keeps the last occurrence", "counterexample": "mtcars <- datasets::mtcars"}, {"expression": "mtcars[!duplicated(mtcars[, c(\"cyl\", \"gear\")]), ]", "what_is_wrong": "wrong column (gear instead of am)", "counterexample": "mtcars <- datasets::mtcars"}]}, {"id": "V-09-006", "key_concern": "", "variants": [{"expression": "apply(M, 2, mean)", "what_is_wrong": "means per question (columns)", "counterexample": "M <- matrix(c(2, 4, 3, 5, 1, 5, 2, 4, 3, 3, 5, 2), nrow = 4, byrow = TRUE)"}, {"expression": "colMeans(M)", "what_is_wrong": "column means instead of row means", "counterexample": "M <- matrix(c(2, 4, 3, 5, 1, 5, 2, 4, 3, 3, 5, 2), nrow = 4, byrow = TRUE)"}, {"expression": "rowSums(M)", "what_is_wrong": "sums instead of means", "counterexample": "M <- matrix(c(2, 4, 3, 5, 1, 5, 2, 4, 3, 3, 5, 2), nrow = 4, byrow = TRUE)"}, {"expression": "mean(M)", "what_is_wrong": "single overall mean", "counterexample": "M <- matrix(c(2, 4, 3, 5, 1, 5, 2, 4, 3, 3, 5, 2), nrow = 4, byrow = TRUE)"}, {"expression": "apply(M, 1, median)", "what_is_wrong": "median instead of mean", "counterexample": "M <- matrix(c(2, 4, 3, 5, 1, 5, 2, 4, 3, 3, 5, 2), nrow = 4, byrow = TRUE)"}]}, {"id": "V-09-007", "key_concern": "", "variants": [{"expression": "x[order(nchar(x))]", "what_is_wrong": "ignores the alphabetical tie-break", "counterexample": "x <- c(\"b\", \"a\")"}, {"expression": "x[order(x, nchar(x))]", "what_is_wrong": "sort keys in the wrong priority", "counterexample": "x <- c(\"b\", \"aa\")"}, {"expression": "sort(x)", "what_is_wrong": "alphabetical only", "counterexample": "x <- c(\"b\", \"aa\")"}, {"expression": "x[order(-nchar(x), x)]", "what_is_wrong": "length descending", "counterexample": "x <- c(\"b\", \"aa\")"}, {"expression": "x[order(nchar(x), x, decreasing = TRUE)]", "what_is_wrong": "both keys descending", "counterexample": "x <- c(\"b\", \"aa\")"}]}, {"id": "V-09-008", "key_concern": "", "variants": [{"expression": "x[-length(x)] - x[-1]", "what_is_wrong": "sign reversed", "counterexample": "x <- c(10, 4, 9, 2)"}, {"expression": "diff(x, lag = 2)", "what_is_wrong": "lag 2 instead of consecutive", "counterexample": "x <- c(10, 4, 9, 2)"}, {"expression": "diff(x, differences = 2)", "what_is_wrong": "second-order differences", "counterexample": "x <- c(10, 4, 9, 2)"}, {"expression": "rev(diff(x))", "what_is_wrong": "reversed order", "counterexample": "x <- c(10, 4, 9, 2)"}, {"expression": "diff(sort(x))", "what_is_wrong": "sorts the values before differencing", "counterexample": "x <- c(10, 4, 9, 2)"}]}, {"id": "V-09-009", "key_concern": "", "variants": [{"expression": "solve(matrix(c(32, 18, 24, 28), nrow = 2))", "what_is_wrong": "column-wise fill gives the transpose", "counterexample": "z <- 0"}, {"expression": "1 / rbind(c(32, 18), c(24, 28))", "what_is_wrong": "elementwise reciprocal", "counterexample": "z <- 0"}, {"expression": "t(rbind(c(32, 18), c(24, 28)))", "what_is_wrong": "transpose, not inverse", "counterexample": "z <- 0"}, {"expression": "solve(cbind(c(32, 18), c(24, 28)))", "what_is_wrong": "uses the vectors as columns", "counterexample": "z <- 0"}]}, {"id": "V-09-010", "key_concern": "", "variants": [{"expression": "df[!duplicated(df[, 1]), ]", "what_is_wrong": "checks the first column only", "counterexample": "df <- data.frame(a = c(1, 1), b = c(1, 2))"}, {"expression": "df[duplicated(df), ]", "what_is_wrong": "returns the duplicates", "counterexample": "df <- data.frame(a = c(1, 1, 2), b = c(1, 1, 3))"}, {"expression": "df[!duplicated(df, fromLast = TRUE), ]", "what_is_wrong": "keeps the last occurrence", "counterexample": "df <- data.frame(a = c(1, 1, 2), b = c(1, 1, 3))"}, {"expression": "unique(df[, 1])", "what_is_wrong": "returns a vector of unique first-column values", "counterexample": "df <- data.frame(a = c(1, 1, 2), b = c(1, 1, 3))"}]}, {"id": "V-09-011", "key_concern": "", "variants": [{"expression": "mean(occ > mean(occ, na.rm = TRUE), na.rm = TRUE)", "what_is_wrong": "untrimmed mean", "counterexample": "occ <- c(0, rep(0.6, 9), NA)"}, {"expression": "mean(occ >= mean(occ, trim = 0.1, na.rm = TRUE), na.rm = TRUE)", "what_is_wrong": ">= instead of strictly greater", "counterexample": "occ <- c(0, rep(0.6, 9), NA)"}, {"expression": "mean(occ > mean(occ, trim = 0.1, na.rm = TRUE))", "what_is_wrong": "missing na.rm in the outer mean gives NA", "counterexample": "occ <- c(0.82, 0.91, NA, 0.76, 0.88, 0.94, 0.79, 0.85, NA, 0.90, 0.83, 0.85)"}, {"expression": "sum(occ > mean(occ, trim = 0.1, na.rm = TRUE), na.rm = TRUE)", "what_is_wrong": "count, not proportion", "counterexample": "occ <- c(0.82, 0.91, NA, 0.76, 0.88, 0.94, 0.79, 0.85, NA, 0.90, 0.83, 0.85)"}, {"expression": "sum(occ > mean(occ, trim = 0.1, na.rm = TRUE), na.rm = TRUE) / length(occ)", "what_is_wrong": "denominator includes the NAs", "counterexample": "occ <- c(0.82, 0.91, NA, 0.76, 0.88, 0.94, 0.79, 0.85, NA, 0.90, 0.83, 0.85)"}]}, {"id": "V-09-012", "key_concern": "", "variants": [{"expression": "length(m == 'flashcards')", "what_is_wrong": "length of the logical vector, not count of TRUE", "counterexample": "m <- factor(c('flashcards', 'reading', 'flashcards', 'group'))"}, {"expression": "mean(m == 'flashcards')", "what_is_wrong": "proportion instead of count", "counterexample": "m <- factor(c('flashcards', 'reading', 'flashcards', 'group'))"}, {"expression": "which(m == 'flashcards')", "what_is_wrong": "returns indices", "counterexample": "m <- factor(c('flashcards', 'reading', 'flashcards', 'group'))"}, {"expression": "nlevels(m)", "what_is_wrong": "number of levels", "counterexample": "m <- factor(c('flashcards', 'reading', 'flashcards', 'group'))"}, {"expression": "sum(m == 'Flashcards')", "what_is_wrong": "wrong case in the level name", "counterexample": "m <- factor(c('flashcards', 'reading', 'flashcards', 'group'))"}]}, {"id": "V-09-013", "key_concern": "", "variants": [{"expression": "tryCatch(solve(M), error = function(e) NA)", "what_is_wrong": "returns NA instead of 0", "counterexample": "M <- matrix(c(1, 2, 2, 4), nrow = 2)"}, {"expression": "tryCatch(solve(M), error = function(e) \"0\")", "what_is_wrong": "returns a character string, not numeric", "counterexample": "M <- matrix(c(1, 2, 2, 4), nrow = 2)"}, {"expression": "try(solve(M), silent = TRUE)", "what_is_wrong": "returns a try-error object, not 0", "counterexample": "M <- matrix(c(1, 2, 2, 4), nrow = 2)"}, {"expression": "tryCatch(solve(M), error = function(e) M)", "what_is_wrong": "returns M instead of 0", "counterexample": "M <- matrix(c(1, 2, 2, 4), nrow = 2)"}, {"expression": "tryCatch(solve(M), error = function(e) conditionMessage(e))", "what_is_wrong": "returns the error message", "counterexample": "M <- matrix(c(1, 2, 2, 4), nrow = 2)"}]}, {"id": "V-09-014", "key_concern": "", "variants": [{"expression": "{n <- 1; while (n <= 20) n <- n * 2}", "what_is_wrong": "does not return n (while returns NULL)", "counterexample": "z <- 0"}, {"expression": "{n <- 1; while (n * 2 <= 20) n <- n * 2; n}", "what_is_wrong": "wrong loop condition, stops at 16", "counterexample": "z <- 0"}, {"expression": "{n <- 1; while (n <= 20) n <- n + 2; n}", "what_is_wrong": "adds 2 instead of multiplying", "counterexample": "z <- 0"}, {"expression": "{n <- 1; while (n <= 20) n <- n * 2; n / 2}", "what_is_wrong": "returns the previous value", "counterexample": "z <- 0"}, {"expression": "{n <- 1; while (n <= 40) n <- n * 2; n}", "what_is_wrong": "wrong threshold", "counterexample": "z <- 0"}]}, {"id": "V-09-015", "key_concern": "", "variants": [{"expression": "function(k) if(k==0) 1 else if(k==1) 0 else k*Recall(k-2)", "what_is_wrong": "factor k instead of k-1", "counterexample": "k <- 4"}, {"expression": "function(k) if(k==0) 1 else if(k==1) 0 else (k-1)*Recall(k-1)", "what_is_wrong": "recurses on k-1", "counterexample": "k <- 4"}, {"expression": "function(k) if(k==0) 1 else if(k==1) 1 else (k-1)*Recall(k-2)", "what_is_wrong": "wrong base case m(1)=1", "counterexample": "k <- 3"}, {"expression": "function(k) if(k==0) 0 else if(k==1) 0 else (k-1)*Recall(k-2)", "what_is_wrong": "wrong base case m(0)=0", "counterexample": "k <- 4"}]}, {"id": "V-09-016", "key_concern": "", "variants": [{"expression": "cor(incidents, response_times, method = \"spearman\")", "what_is_wrong": "Spearman instead of Pearson", "counterexample": "incidents <- c(12, 15, 10, 18, 20); response_times <- c(4.5, 5.2, 3.8, 6.1, 7.0)"}, {"expression": "cov(incidents, response_times)", "what_is_wrong": "covariance, not correlation", "counterexample": "incidents <- c(12, 15, 10, 18, 20); response_times <- c(4.5, 5.2, 3.8, 6.1, 7.0)"}, {"expression": "cor(incidents, response_times)^2", "what_is_wrong": "R squared", "counterexample": "incidents <- c(12, 15, 10, 18, 20); response_times <- c(4.5, 5.2, 3.8, 6.1, 7.0)"}, {"expression": "cor(incidents, response_times, method = \"kendall\")", "what_is_wrong": "Kendall tau", "counterexample": "incidents <- c(12, 15, 10, 18, 20); response_times <- c(4.5, 5.2, 3.8, 6.1, 7.0)"}, {"expression": "cor.test(incidents, response_times)", "what_is_wrong": "returns a test object, not the coefficient", "counterexample": "incidents <- c(12, 15, 10, 18, 20); response_times <- c(4.5, 5.2, 3.8, 6.1, 7.0)"}]}, {"id": "V-09-017", "key_concern": "", "variants": [{"expression": "residuals(fit)", "what_is_wrong": "deviance residuals by default", "counterexample": "x <- c(1, 2, 3, 4, 5); y <- c(2, 4, 5, 4, 5); fit <- glm(y ~ x, family = poisson)"}, {"expression": "residuals(fit, type = \"response\")", "what_is_wrong": "raw response residuals", "counterexample": "x <- c(1, 2, 3, 4, 5); y <- c(2, 4, 5, 4, 5); fit <- glm(y ~ x, family = poisson)"}, {"expression": "residuals(fit, type = \"working\")", "what_is_wrong": "working residuals", "counterexample": "x <- c(1, 2, 3, 4, 5); y <- c(2, 4, 5, 4, 5); fit <- glm(y ~ x, family = poisson)"}, {"expression": "rstandard(fit, type = \"pearson\")", "what_is_wrong": "standardized, not raw Pearson residuals", "counterexample": "x <- c(1, 2, 3, 4, 5); y <- c(2, 4, 5, 4, 5); fit <- glm(y ~ x, family = poisson)"}, {"expression": "(y - fitted(fit)) / fitted(fit)", "what_is_wrong": "divides by mu instead of sqrt(mu)", "counterexample": "x <- c(1, 2, 3, 4, 5); y <- c(2, 4, 5, 4, 5); fit <- glm(y ~ x, family = poisson)"}]}, {"id": "V-09-018", "key_concern": "", "variants": [{"expression": "replicate(1000, mean(sample(x)))", "what_is_wrong": "samples without replacement, so every mean equals mean(x)", "counterexample": "set.seed(1); x <- c(1, 3, 5, 7)"}, {"expression": "sample(x, 1000, replace = TRUE)", "what_is_wrong": "resampled values, not means", "counterexample": "set.seed(1); x <- c(1, 3, 5, 7)"}, {"expression": "mean(replicate(1000, mean(sample(x, replace = TRUE))))", "what_is_wrong": "averages the replicates into one number", "counterexample": "set.seed(1); x <- c(1, 3, 5, 7)"}, {"expression": "replicate(1000, median(sample(x, replace = TRUE)))", "what_is_wrong": "median instead of mean", "counterexample": "set.seed(1); x <- c(1, 3, 5, 7)"}, {"expression": "replicate(1000, mean(sample(x, 1, replace = TRUE)))", "what_is_wrong": "resample size 1 instead of n", "counterexample": "set.seed(1); x <- c(1, 3, 5, 7)"}]}, {"id": "V-09-019", "key_concern": "", "variants": [{"expression": "sapply(L, function(x) c(mean(x), sd(x)))", "what_is_wrong": "rows unnamed", "counterexample": "L <- list(b1 = c(10.2, 10.5, 10.1), b2 = c(10.4, 10.6), b3 = c(10.0, 10.2, 10.1, 10.3))"}, {"expression": "sapply(L, function(x) c(mean = mean(x), sd = var(x)))", "what_is_wrong": "variance instead of sd", "counterexample": "L <- list(b1 = c(10.2, 10.5, 10.1), b2 = c(10.4, 10.6), b3 = c(10.0, 10.2, 10.1, 10.3))"}, {"expression": "t(sapply(L, function(x) c(mean = mean(x), sd = sd(x))))", "what_is_wrong": "transposed (batches as rows)", "counterexample": "L <- list(b1 = c(10.2, 10.5, 10.1), b2 = c(10.4, 10.6), b3 = c(10.0, 10.2, 10.1, 10.3))"}, {"expression": "sapply(L, mean)", "what_is_wrong": "means only, returns a vector", "counterexample": "L <- list(b1 = c(10.2, 10.5, 10.1), b2 = c(10.4, 10.6), b3 = c(10.0, 10.2, 10.1, 10.3))"}, {"expression": "sapply(L, function(x) c(mean = mean(x), sd = sd(x) / sqrt(length(x))))", "what_is_wrong": "standard error instead of sd", "counterexample": "L <- list(b1 = c(10.2, 10.5, 10.1), b2 = c(10.4, 10.6), b3 = c(10.0, 10.2, 10.1, 10.3))"}]}]}