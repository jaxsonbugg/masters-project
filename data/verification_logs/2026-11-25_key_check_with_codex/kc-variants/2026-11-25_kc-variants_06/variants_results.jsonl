{"item_id": "BM0578", "position": 578, "batch": "2026-11-25_kc-variants_06", "anon_id": "V-06-013", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "function(x) (length(x) - 1) * var(x) / qchisq(c(0.025, 0.975), length(x) - 1)", "what_is_wrong": "quantiles in the wrong order (upper bound first)", "counterexample": "x <- c(2, 4, 7, 9, 13)"}, {"expression": "function(x) (length(x) - 1) * var(x) / qchisq(c(0.975, 0.025), length(x))", "what_is_wrong": "wrong degrees of freedom (n instead of n - 1)", "counterexample": "x <- c(2, 4, 7, 9, 13)"}, {"expression": "function(x) (length(x) - 1) * var(x) / qchisq(c(0.95, 0.05), length(x) - 1)", "what_is_wrong": "gives a 90% interval", "counterexample": "x <- c(2, 4, 7, 9, 13)"}, {"expression": "function(x) length(x) * var(x) / qchisq(c(0.975, 0.025), length(x) - 1)", "what_is_wrong": "multiplies by n instead of n - 1", "counterexample": "x <- c(2, 4, 7, 9, 13)"}, {"expression": "function(x) sqrt((length(x) - 1) * var(x) / qchisq(c(0.975, 0.025), length(x) - 1))", "what_is_wrong": "CI for the sd, not the variance", "counterexample": "x <- c(2, 4, 7, 9, 13)"}]}
