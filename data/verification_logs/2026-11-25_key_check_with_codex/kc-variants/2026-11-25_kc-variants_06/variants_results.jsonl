{"item_id": "BM0549", "position": 549, "batch": "2026-11-25_kc-variants_06", "anon_id": "V-06-007", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "rbind(cbind(approval, spending), colMeans(cbind(approval, spending)))", "what_is_wrong": "column means instead of sums", "counterexample": "approval <- c(1, 0, 1, 1, 0); spending <- c(520, 410, 580, 490, 370)"}, {"expression": "cbind(rbind(approval, spending), rowSums(rbind(approval, spending)))", "what_is_wrong": "wrong orientation: variables as rows, totals as a column", "counterexample": "approval <- c(1, 0, 1, 1, 0); spending <- c(520, 410, 580, 490, 370)"}, {"expression": "rbind(cbind(approval, spending), sum(approval, spending))", "what_is_wrong": "grand total recycled instead of per-column sums", "counterexample": "approval <- c(1, 0, 1, 1, 0); spending <- c(520, 410, 580, 490, 370)"}, {"expression": "cbind(approval, spending, approval + spending)", "what_is_wrong": "appends a row-sum column instead of a column-sum row", "counterexample": "approval <- c(1, 0, 1, 1, 0); spending <- c(520, 410, 580, 490, 370)"}]}
