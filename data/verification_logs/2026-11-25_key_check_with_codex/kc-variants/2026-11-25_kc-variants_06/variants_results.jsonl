{"item_id": "BM0518", "position": 518, "batch": "2026-11-25_kc-variants_06", "anon_id": "V-06-001", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "outer(colSums(m), rowSums(m)) / sum(m)", "what_is_wrong": "row and column margins swapped (transposed result)", "counterexample": "m <- matrix(c(12,18,24,15,25,35,20,30,40), nrow = 3, byrow = TRUE)"}, {"expression": "rowSums(m) * colSums(m) / sum(m)", "what_is_wrong": "elementwise product gives a vector, not a 3x3 matrix", "counterexample": "m <- matrix(c(12,18,24,15,25,35,20,30,40), nrow = 3, byrow = TRUE)"}, {"expression": "outer(rowSums(m), colSums(m)) / length(m)", "what_is_wrong": "divides by the number of cells instead of the grand total", "counterexample": "m <- matrix(c(12,18,24,15,25,35,20,30,40), nrow = 3, byrow = TRUE)"}, {"expression": "outer(rowSums(m), colSums(m), \"+\") / sum(m)", "what_is_wrong": "adds the margins instead of multiplying them", "counterexample": "m <- matrix(c(12,18,24,15,25,35,20,30,40), nrow = 3, byrow = TRUE)"}, {"expression": "outer(rowMeans(m), colMeans(m))", "what_is_wrong": "uses margin means and no division by the total", "counterexample": "m <- matrix(c(12,18,24,15,25,35,20,30,40), nrow = 3, byrow = TRUE)"}]}
{"item_id": "BM0523", "position": 523, "batch": "2026-11-25_kc-variants_06", "anon_id": "V-06-002", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "lm(commute_time ~ traffic_volume + road_type, data = routes)", "what_is_wrong": "omits the interaction term", "counterexample": "routes <- data.frame(commute_time = c(10,14,13,20,25,40), traffic_volume = c(1,2,3,1,2,3), road_type = c('highway','highway','highway','surface','surface','surface'))"}, {"expression": "lm(commute_time ~ traffic_volume:road_type, data = routes)", "what_is_wrong": "only the interaction, no main effects", "counterexample": "routes <- data.frame(commute_time = c(10,14,13,20,25,40), traffic_volume = c(1,2,3,1,2,3), road_type = c('highway','highway','highway','surface','surface','surface'))"}, {"expression": "lm(traffic_volume ~ commute_time * road_type, data = routes)", "what_is_wrong": "response and predictor swapped", "counterexample": "routes <- data.frame(commute_time = c(10,14,13,20,25,40), traffic_volume = c(1,2,3,1,2,3), road_type = c('highway','highway','highway','surface','surface','surface'))"}, {"expression": "lm(commute_time ~ traffic_volume + traffic_volume:road_type, data = routes)", "what_is_wrong": "missing the road_type main effect", "counterexample": "routes <- data.frame(commute_time = c(10,14,13,20,25,40), traffic_volume = c(1,2,3,1,2,3), road_type = c('highway','highway','highway','surface','surface','surface'))"}]}
