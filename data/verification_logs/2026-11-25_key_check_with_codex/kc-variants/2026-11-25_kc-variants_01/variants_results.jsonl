{"item_id": "BM0009", "position": 9, "batch": "2026-11-25_kc-variants_01", "anon_id": "V-01-001", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "model.matrix(~ type * temp, data = components)", "what_is_wrong": "adds interaction term", "counterexample": "components <- data.frame(life = c(120, 150, 130, 140, 160, 110), type = factor(c(\"X\", \"X\", \"Y\", \"Y\", \"X\", \"Y\")), temp = c(200, 200, 200, 250, 250, 250))"}, {"expression": "model.matrix(~ type + temp - 1, data = components)", "what_is_wrong": "drops intercept, changes coding", "counterexample": "components <- data.frame(life = c(120, 150, 130, 140, 160, 110), type = factor(c(\"X\", \"X\", \"Y\", \"Y\", \"X\", \"Y\")), temp = c(200, 200, 200, 250, 250, 250))"}, {"expression": "model.matrix(~ type, data = components)", "what_is_wrong": "omits temp", "counterexample": "components <- data.frame(life = c(120, 150, 130, 140, 160, 110), type = factor(c(\"X\", \"X\", \"Y\", \"Y\", \"X\", \"Y\")), temp = c(200, 200, 200, 250, 250, 250))"}, {"expression": "model.matrix(~ type + factor(temp), data = components)", "what_is_wrong": "treats temp as factor", "counterexample": "components <- data.frame(life = c(120, 150, 130, 140, 160, 110), type = factor(c(\"X\", \"X\", \"Y\", \"Y\", \"X\", \"Y\")), temp = c(200, 200, 200, 250, 250, 250))"}, {"expression": "model.matrix(life ~ type, data = components)", "what_is_wrong": "wrong formula, omits temp", "counterexample": "components <- data.frame(life = c(120, 150, 130, 140, 160, 110), type = factor(c(\"X\", \"X\", \"Y\", \"Y\", \"X\", \"Y\")), temp = c(200, 200, 200, 250, 250, 250))"}]}
{"item_id": "BM0158", "position": 158, "batch": "2026-11-25_kc-variants_01", "anon_id": "V-01-002", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "diag(table(a, b)) matches cells by position, not by value, so the key is wrong when a and b have different sets of values; e.g. a = c(1L, 2L), b = c(2L, 3L) gives 2 although no indices match.", "variants": [{"expression": "sum(table(a, b))", "what_is_wrong": "counts all pairs, not matches", "counterexample": "a <- c(1L, 2L, 3L); b <- c(1L, 2L, 1L)"}, {"expression": "sum(table(a == b))", "what_is_wrong": "counts all indices", "counterexample": "a <- c(1L, 2L, 3L); b <- c(1L, 2L, 1L)"}, {"expression": "table(a == b)[1]", "what_is_wrong": "takes FALSE count (mismatches)", "counterexample": "a <- c(1L, 2L, 3L); b <- c(1L, 2L, 1L)"}, {"expression": "length(diag(table(a, b)))", "what_is_wrong": "length instead of sum", "counterexample": "a <- c(1L, 1L); b <- c(1L, 1L)"}, {"expression": "sum(diag(table(a, b))) / length(a)", "what_is_wrong": "returns proportion not count", "counterexample": "a <- c(1L, 2L); b <- c(1L, 1L)"}]}
{"item_id": "BM0618", "position": 618, "batch": "2026-11-25_kc-variants_01", "anon_id": "V-01-003", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "tapply(x, g, length) does not omit the unused level; it returns NA for it. Something like tapply(x, droplevels(g), length) is needed.", "variants": [{"expression": "table(g)", "what_is_wrong": "keeps unused level with 0", "counterexample": "x <- c(1.5, 2, 3); g <- factor(c(\"a\", \"a\", \"b\"), levels = c(\"a\", \"b\", \"c\"))"}, {"expression": "tapply(x, g, sum)", "what_is_wrong": "sums values instead of counting", "counterexample": "x <- c(1.5, 2, 3); g <- factor(c(\"a\", \"a\", \"b\"), levels = c(\"a\", \"b\", \"c\"))"}, {"expression": "sapply(split(x, g), length)", "what_is_wrong": "keeps unused level as 0", "counterexample": "x <- c(1.5, 2, 3); g <- factor(c(\"a\", \"a\", \"b\"), levels = c(\"a\", \"b\", \"c\"))"}, {"expression": "tapply(x, g, mean)", "what_is_wrong": "mean instead of count", "counterexample": "x <- c(1.5, 2, 3); g <- factor(c(\"a\", \"a\", \"b\"), levels = c(\"a\", \"b\", \"c\"))"}, {"expression": "summary(g)", "what_is_wrong": "keeps unused level as 0", "counterexample": "x <- c(1.5, 2, 3); g <- factor(c(\"a\", \"a\", \"b\"), levels = c(\"a\", \"b\", \"c\"))"}]}
{"item_id": "BM0829", "position": 829, "batch": "2026-11-25_kc-variants_01", "anon_id": "V-01-004", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "gsub(\"([A-Z]):([0-9])\", \"\\\\1:\\\\2\", v)", "what_is_wrong": "backreferences not swapped", "counterexample": "v <- c(\"A:1\", \"B:2\", \"C:3\")"}, {"expression": "gsub(\"([A-Z]):([0-9])\", \"2:1\", v)", "what_is_wrong": "literal digits, not backreferences", "counterexample": "v <- c(\"A:1\", \"B:2\", \"C:3\")"}, {"expression": "gsub(\"([0-9]):([A-Z])\", \"\\\\2:\\\\1\", v)", "what_is_wrong": "pattern order reversed, no match", "counterexample": "v <- c(\"A:1\", \"B:2\", \"C:3\")"}, {"expression": "gsub(\"([A-Z]):([0-9])\", \"\\\\2\\\\1\", v)", "what_is_wrong": "drops colon", "counterexample": "v <- c(\"A:1\", \"B:2\", \"C:3\")"}]}
{"item_id": "BM0863", "position": 863, "batch": "2026-11-25_kc-variants_01", "anon_id": "V-01-005", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "critical %in% logs", "what_is_wrong": "operands reversed", "counterexample": "logs <- c(404, 500, 200, 500, 503); critical <- c(500, 503)"}, {"expression": "logs == critical", "what_is_wrong": "elementwise recycling comparison", "counterexample": "logs <- c(404, 500, 200, 500, 503); critical <- c(500, 503)"}, {"expression": "match(logs, critical)", "what_is_wrong": "returns positions not logical", "counterexample": "logs <- c(404, 500, 200, 500, 503); critical <- c(500, 503)"}, {"expression": "which(logs %in% critical)", "what_is_wrong": "returns indices not logical", "counterexample": "logs <- c(404, 500, 200, 500, 503); critical <- c(500, 503)"}, {"expression": "any(logs %in% critical)", "what_is_wrong": "single value not vector", "counterexample": "logs <- c(404, 500, 200, 500, 503); critical <- c(500, 503)"}]}
{"item_id": "BM1743", "position": 458, "batch": "2026-11-25_kc-variants_01", "anon_id": "V-01-006", "kind": "variants", "role": "variants", "model": "claude-opus-5-5", "key_concern": "", "variants": [{"expression": "table(x)", "what_is_wrong": "no zero for q, alphabetical order", "counterexample": "x <- c('m', 'k', 'p', 'm', 'k'); L <- c('p', 'm', 'k', 'q')"}, {"expression": "table(factor(x, levels = sort(L)))", "what_is_wrong": "wrong order of levels", "counterexample": "x <- c('m', 'k', 'p', 'm', 'k'); L <- c('p', 'm', 'k', 'q')"}, {"expression": "table(factor(x, levels = unique(x)))", "what_is_wrong": "ignores L, missing q", "counterexample": "x <- c('m', 'k', 'p', 'm', 'k'); L <- c('p', 'm', 'k', 'q')"}, {"expression": "table(x)[L]", "what_is_wrong": "NA instead of zero for q", "counterexample": "x <- c('m', 'k', 'p', 'm', 'k'); L <- c('p', 'm', 'k', 'q')"}, {"expression": "table(factor(L, levels = L))", "what_is_wrong": "tabulates L instead of x", "counterexample": "x <- c('m', 'k', 'p', 'm', 'k'); L <- c('p', 'm', 'k', 'q')"}]}
