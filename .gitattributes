# Shell and Slurm scripts must keep Unix line endings (a Windows CR character breaks them on Redhawk).
*.sh text eol=lf
*.sbatch text eol=lf
# Files whose SHA-256 is pinned or recorded on their LF bytes (added 2026-11-20): `git archive` on this PC (the Talon copy) must not
# give them Windows line endings, or a Talon job would refuse them. The v6 prompt is NOT listed: its pin was computed on CRLF bytes.
data/prompts/benchmark_generation_v7.md text eol=lf
data/prompts/training_generation_v1.md text eol=lf
data/prompts/benchmark_generation_v8.md text eol=lf
data/prompts/training_generation_v2.md text eol=lf
data/taxonomy/*.yaml text eol=lf
data/slots/** text eol=lf
data/prompts/align_v1.md text eol=lf
data/prompts/screen_v1.md text eol=lf
